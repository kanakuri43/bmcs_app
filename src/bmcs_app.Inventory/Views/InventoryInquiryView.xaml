<mah:MetroWindow x:Class="bmcs_app.Inventory.Views.InventoryInquiryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    Title="在庫照会"
    Height="720" Width="1100"
    WindowStartupLocation="CenterScreen"
    WindowTransitionsEnabled="False">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- ToolBar -->
            <RowDefinition Height="Auto" />  <!-- 検索バー -->
            <RowDefinition Height="*"    />  <!-- DataGrid -->
            <RowDefinition Height="Auto" />  <!-- ページネーション -->
            <RowDefinition Height="Auto" />  <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- ===== ToolBar ===== -->
        <ToolBar Grid.Row="0" ToolBarTray.IsLocked="True">
            <Button Command="{Binding RefreshCommand}"
                    Content="更新 (F5)"
                    ToolTip="在庫を再計算して表示を更新します (F5)" />
        </ToolBar>

        <!-- ===== 検索バー ===== -->
        <Border Grid.Row="1"
                Padding="12,8"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource MahApps.Brushes.Gray10}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"  />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*"   />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="商品検索" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         mah:TextBoxHelper.Watermark="コード・商品名"
                         mah:TextBoxHelper.ClearTextButton="True">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </Grid>
        </Border>

        <!-- ===== 在庫一覧 DataGrid ===== -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  ColumnHeaderHeight="28"
                  RowHeight="24">
            <DataGrid.Columns>
                <DataGridTextColumn Header="商品コード"
                                    Binding="{Binding ProductCode}"
                                    Width="100" />
                <DataGridTextColumn Header="商品名"
                                    Binding="{Binding ProductName}"
                                    Width="*" />
                <DataGridTextColumn Header="現在庫数"
                                    Binding="{Binding CurrentStockDisplay}"
                                    Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Padding" Value="4,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="最終棚卸日"
                                    Binding="{Binding LastCountDateDisplay}"
                                    Width="100" />
                <DataGridTextColumn Header="棚卸数"
                                    Binding="{Binding LastCountQtyDisplay}"
                                    Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Padding" Value="4,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="棚卸後仕入"
                                    Binding="{Binding PurchaseQty, StringFormat={}{0:N2}}"
                                    Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Padding" Value="4,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="棚卸後売上"
                                    Binding="{Binding SaleQty, StringFormat={}{0:N2}}"
                                    Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Padding" Value="4,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>

            <!-- 未棚卸行をグレーアウト -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNeverCounted}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray5}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- ===== ページネーション ===== -->
        <Border Grid.Row="3"
                Padding="12,4"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding PageLabel}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding FirstPageCommand}" Content="|◀" Width="32"
                            Style="{DynamicResource MahApps.Styles.Button.Flat}" />
                    <Button Command="{Binding PrevPageCommand}"  Content="◀"  Width="32"
                            Style="{DynamicResource MahApps.Styles.Button.Flat}" />
                    <Button Command="{Binding NextPageCommand}"  Content="▶"  Width="32"
                            Style="{DynamicResource MahApps.Styles.Button.Flat}" />
                    <Button Command="{Binding LastPageCommand}"  Content="▶|" Width="32"
                            Style="{DynamicResource MahApps.Styles.Button.Flat}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== StatusBar ===== -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</mah:MetroWindow>
