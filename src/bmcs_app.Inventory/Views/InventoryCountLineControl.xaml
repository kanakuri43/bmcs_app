<UserControl x:Class="bmcs_app.Inventory.Views.InventoryCountLineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:h="clr-namespace:bmcs_app.Shared.Helpers;assembly=bmcs_app.Shared">

    <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray9}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"  />  <!-- 行番号 -->
                <ColumnDefinition Width="110" />  <!-- 商品コード -->
                <ColumnDefinition Width="*"   />  <!-- 商品名 -->
                <ColumnDefinition Width="90"  />  <!-- 数量 -->
                <ColumnDefinition Width="200" />  <!-- 備考 -->
                <ColumnDefinition Width="28"  />  <!-- 削除 -->
            </Grid.ColumnDefinitions>

            <!-- 行番号 -->
            <TextBlock Grid.Column="0"
                       Text="{Binding LineNo}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource MahApps.Brushes.Gray3}" />

            <!-- 商品コード -->
            <TextBox x:Name="ProductCodeBox"
                     Grid.Column="1"
                     Text="{Binding EditProductCode, UpdateSourceTrigger=PropertyChanged}"
                     mah:TextBoxHelper.Watermark="コード"
                     MaxLength="20"
                     GotKeyboardFocus="OnTextBoxGotKeyboardFocus"
                     Margin="1,1,0,1">
                <TextBox.InputBindings>
                    <KeyBinding Key="Space"  Command="{Binding OpenProductLookupCommand}" />
                    <KeyBinding Key="Return" Command="{Binding LookupProductByCodeCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <!-- 商品名（表示のみ） -->
            <TextBlock Grid.Column="2"
                       Text="{Binding EditProductName}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                       Padding="4,0"
                       TextTrimming="CharacterEllipsis" />

            <!-- 数量 -->
            <TextBox x:Name="QuantityBox"
                     Grid.Column="3"
                     Text="{Binding EditQuantity, UpdateSourceTrigger=PropertyChanged}"
                     TextAlignment="Right"
                     h:FocusHelper.MoveNextOnEnter="True"
                     GotKeyboardFocus="OnTextBoxGotKeyboardFocus"
                     Margin="2,1,0,1" />

            <!-- 備考 -->
            <TextBox x:Name="NoteBox"
                     Grid.Column="4"
                     Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}"
                     mah:TextBoxHelper.Watermark="（任意）"
                     MaxLength="200"
                     GotKeyboardFocus="OnTextBoxGotKeyboardFocus"
                     Margin="2,1,0,1">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding NoteEnterCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <!-- 行削除 -->
            <Button Grid.Column="5"
                    Command="{Binding DeleteLineCommand}"
                    Content="×"
                    IsTabStop="False"
                    FontSize="10"
                    Padding="0"
                    Margin="2,1,1,1"
                    ToolTip="この行を削除"
                    Style="{DynamicResource MahApps.Styles.Button.Flat}" />
        </Grid>
    </Border>
</UserControl>
