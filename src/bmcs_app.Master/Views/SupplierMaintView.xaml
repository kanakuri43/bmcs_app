<mah:MetroWindow x:Class="bmcs_app.Master.Views.SupplierMaintView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    Title="仕入先マスタ"
    Height="720" Width="1100"
    WindowStartupLocation="CenterScreen"
    WindowTransitionsEnabled="False">

    <Window.InputBindings>
        <KeyBinding Key="F3"  Command="{Binding NewCommand}" />
        <KeyBinding Key="F8"  Command="{Binding DeleteCommand}" />
        <KeyBinding Key="F10" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"    />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ツールバー -->
        <ToolBar Grid.Row="0" ToolBarTray.IsLocked="True">
            <Button Command="{Binding NewCommand}"
                    Content="新規 (F3)"
                    ToolTip="新規入力モードにします (F3)" />
        </ToolBar>

        <!-- メインコンテンツ: 一覧 | 編集フォーム -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"   />
                <ColumnDefinition Width="5"   />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- 一覧列: 検索ボックス + DataGrid + ページセレクタ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"    />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- キーワード検索 -->
                <TextBox Grid.Row="0"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         mah:TextBoxHelper.Watermark="キーワード検索（Enter で絞り込み）"
                         mah:TextBoxHelper.ClearTextButton="True"
                         Margin="4,4,4,2">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <!-- 仕入先一覧 -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Suppliers}"
                          SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="コード"
                                            Binding="{Binding SupplierCode}"
                                            Width="120" />
                        <DataGridTextColumn Header="名称"
                                            Binding="{Binding SupplierName}"
                                            Width="*" />
                        <DataGridTextColumn Header="締日"
                                            Binding="{Binding ClosingDay}"
                                            Width="60" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- ページセレクタ -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                        BorderThickness="0,1,0,0"
                        Padding="4,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*"    />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="|◀"
                                    Command="{Binding FirstPageCommand}"
                                    ToolTip="先頭ページ"
                                    Padding="6,0" Margin="0,0,2,0"
                                    Style="{DynamicResource MahApps.Styles.Button.Flat}" />
                            <Button Content="◀"
                                    Command="{Binding PrevPageCommand}"
                                    ToolTip="前のページ"
                                    Padding="6,0"
                                    Style="{DynamicResource MahApps.Styles.Button.Flat}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding PageLabel}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="▶"
                                    Command="{Binding NextPageCommand}"
                                    ToolTip="次のページ"
                                    Padding="6,0" Margin="0,0,2,0"
                                    Style="{DynamicResource MahApps.Styles.Button.Flat}" />
                            <Button Content="▶|"
                                    Command="{Binding LastPageCommand}"
                                    ToolTip="最終ページ"
                                    Padding="6,0"
                                    Style="{DynamicResource MahApps.Styles.Button.Flat}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource MahApps.Brushes.Gray8}" />

            <!-- 編集フォーム -->
            <Border Grid.Column="2"
                    Margin="4"
                    Padding="12"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"    />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 入力欄 -->
                    <StackPanel Grid.Row="0">
                        <CheckBox Content="諸口"
                                  IsChecked="{Binding EditIsMiscellaneous}"
                                  Margin="0,0,0,8" />

                        <Label Content="仕入先コード" />
                        <TextBox Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsEditCodeReadOnly}"
                                 mah:TextBoxHelper.Watermark="例: S001"
                                 MaxLength="20"
                                 Margin="0,0,0,8" />

                        <Label Content="仕入先名" />
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="例: 株式会社 北海道物産"
                                 MaxLength="100"
                                 Margin="0,0,0,8" />

                        <Label Content="締日（月末=99 / 諸口=0）" />
                        <TextBox Text="{Binding EditClosingDay, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="例: 20 または 99"
                                 MaxLength="2"
                                 Margin="0,0,0,8">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsClosingDayEditable}" Value="False">
                                            <Setter Property="IsReadOnly" Value="True" />
                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Label Content="税端数区分" />
                        <ComboBox ItemsSource="{Binding TaxFractions}"
                                  SelectedItem="{Binding EditTaxFraction}"
                                  DisplayMemberPath="TaxFractionName"
                                  Margin="0,0,0,8" />

                        <Label Content="税計算単位区分" />
                        <ComboBox ItemsSource="{Binding TaxCalcUnits}"
                                  SelectedItem="{Binding EditTaxCalcUnit}"
                                  DisplayMemberPath="TaxCalcUnitName"
                                  Margin="0,0,0,8" />

                        <Label Content="担当者" />
                        <ComboBox ItemsSource="{Binding Employees}"
                                  SelectedItem="{Binding EditEmployee}"
                                  Margin="0,0,0,8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding EmployeeName}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="（担当者なし）" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Label Content="郵便番号" />
                        <TextBox Text="{Binding EditPostalCode, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="例: 060-0001"
                                 MaxLength="8"
                                 Margin="0,0,0,8" />

                        <Label Content="住所1" />
                        <TextBox Text="{Binding EditAddress1, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="例: 北海道札幌市中央区北1条西2丁目"
                                 MaxLength="100"
                                 Margin="0,0,0,8" />

                        <Label Content="住所2" />
                        <TextBox Text="{Binding EditAddress2, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="例: ○○ビル 3F"
                                 MaxLength="100"
                                 Margin="0,0,0,8" />

                        <Label Content="登録番号（T番号）" />
                        <TextBox Text="{Binding EditInvoiceNo, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="例: T1234567890123"
                                 MaxLength="14"
                                 Margin="0,0,0,8" />
                    </StackPanel>

                    <!-- 保存・削除ボタン（右下） -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0">
                        <Button Command="{Binding DeleteCommand}"
                                Content="削除 (F8)"
                                ToolTip="選択中のレコードを削除します (F8)"
                                Margin="0,0,8,0" />
                        <Button Command="{Binding SaveCommand}"
                                Content="保存 (F10)"
                                ToolTip="入力内容を保存します (F10)"
                                Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ステータスバー -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</mah:MetroWindow>
