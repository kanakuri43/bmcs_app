<mah:MetroWindow x:Class="bmcs_app.Sales.Views.SalesMainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:h="clr-namespace:bmcs_app.Sales.Helpers"
    Title="売上伝票"
    Height="720" Width="1100"
    WindowStartupLocation="CenterScreen"
    WindowTransitionsEnabled="False"
    FocusManager.FocusedElement="{Binding ElementName=SaleNoBox}">

    <Window.InputBindings>
        <KeyBinding Key="F2"  Command="{Binding AddLineCommand}" />
        <KeyBinding Key="F3"  Command="{Binding NewCommand}" />
        <KeyBinding Key="F8"  Command="{Binding DeleteSlipCommand}" />
        <KeyBinding Key="F10" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F11" Command="{Binding PrintCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- ToolBar -->
            <RowDefinition Height="Auto" />  <!-- ヘッダー -->
            <RowDefinition Height="*"    />  <!-- 明細 -->
            <RowDefinition Height="Auto" />  <!-- フッター集計 -->
            <RowDefinition Height="Auto" />  <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- ===== ToolBar ===== -->
        <ToolBar Grid.Row="0" ToolBarTray.IsLocked="True">
            <Button Command="{Binding NewCommand}"
                    Content="新規 (F3)"
                    ToolTip="新規伝票を作成します (F3)" />
            <Separator />
            <Button Command="{Binding PrevSlipCommand}"
                    Content="|◀"
                    ToolTip="前の伝票"
                    Style="{DynamicResource MahApps.Styles.Button.Flat}" />
            <Button Command="{Binding NextSlipCommand}"
                    Content="▶|"
                    ToolTip="次の伝票"
                    Style="{DynamicResource MahApps.Styles.Button.Flat}" />
            <Separator />
            <TextBlock Text="登録件数:"
                       VerticalAlignment="Center"
                       Margin="4,0,2,0"
                       Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
            <TextBlock Text="{Binding TotalSlipCount}"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MahApps.Brushes.Accent}" />
        </ToolBar>

        <!-- ===== 伝票ヘッダー ===== -->
        <Border Grid.Row="1"
                Padding="12,8"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource MahApps.Brushes.Gray10}">
            <StackPanel>

                <!-- 行1: 売上日付 / 伝票No. / 受注No. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"  />  <!-- label -->
                        <ColumnDefinition Width="140" />  <!-- value -->
                        <ColumnDefinition Width="16"  />
                        <ColumnDefinition Width="58"  />  <!-- label -->
                        <ColumnDefinition Width="130" />  <!-- value -->
                        <ColumnDefinition Width="16"  />
                        <ColumnDefinition Width="58"  />  <!-- label -->
                        <ColumnDefinition Width="130" />  <!-- value -->
                        <ColumnDefinition Width="*"   />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="売上日付" VerticalAlignment="Center" />
                    <DatePicker Grid.Column="1"
                                SelectedDate="{Binding EditSaleDate}"
                                SelectedDateFormat="Short" />

                    <TextBlock Grid.Column="3" Text="伝票No." VerticalAlignment="Center" />
                    <TextBox x:Name="SaleNoBox"
                             Grid.Column="4"
                             h:FocusHelper.MoveNextOnEnter="True"
                             Text="{Binding EditSaleNo, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="自動採番"
                             mah:TextBoxHelper.ClearTextButton="True"
                             MaxLength="20">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Space"  Command="{Binding OpenSlipLookupCommand}" />
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <TextBlock Grid.Column="6" Text="受注No." VerticalAlignment="Center" />
                    <TextBox Grid.Column="7"
                             h:FocusHelper.MoveNextOnEnter="True"
                             Text="{Binding EditOrderNo, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="（任意）"
                             mah:TextBoxHelper.ClearTextButton="True"
                             MaxLength="20">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Space"  Command="{Binding OpenOrderLookupCommand}" />
                            <KeyBinding Key="Return" Command="{Binding LookupOrderByNoCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>

                <!-- 行2: 得意先 -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"  />  <!-- label -->
                        <ColumnDefinition Width="110" />  <!-- code -->
                        <ColumnDefinition Width="8"   />
                        <ColumnDefinition Width="*"   />  <!-- name -->
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="得意先" VerticalAlignment="Center" />
                    <TextBox x:Name="CustomerCodeBox"
                             Grid.Column="1"
                             h:FocusHelper.MoveNextOnEnter="True"
                             Text="{Binding EditCustomerCode, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="コード"
                             mah:TextBoxHelper.ClearTextButton="True"
                             MaxLength="20">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Space"  Command="{Binding OpenCustomerLookupCommand}" />
                            <KeyBinding Key="Return" Command="{Binding LookupCustomerByCodeCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBox Grid.Column="3"
                             Text="{Binding EditCustomerName, Mode=OneWay}"
                             IsReadOnly="True"
                             IsTabStop="False"
                             Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                </Grid>

                <!-- 行3: 担当者 -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"  />  <!-- label -->
                        <ColumnDefinition Width="110" />  <!-- code -->
                        <ColumnDefinition Width="8"   />
                        <ColumnDefinition Width="240" />  <!-- name -->
                        <ColumnDefinition Width="*"   />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="担当者" VerticalAlignment="Center" />
                    <TextBox x:Name="EmployeeCodeBox"
                             Grid.Column="1"
                             h:FocusHelper.MoveNextOnEnter="True"
                             Text="{Binding EditEmployeeCode, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="コード"
                             mah:TextBoxHelper.ClearTextButton="True"
                             MaxLength="20">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Space"  Command="{Binding OpenEmployeeLookupCommand}" />
                            <KeyBinding Key="Return" Command="{Binding LookupEmployeeByCodeCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBox Grid.Column="3"
                             Text="{Binding EditEmployeeName, Mode=OneWay}"
                             IsReadOnly="True"
                             IsTabStop="False"
                             Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                </Grid>

                <!-- 行4: 摘要 -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*"  />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="摘要" VerticalAlignment="Center" />
                    <TextBox x:Name="RemarksBox"
                             Grid.Column="1"
                             Text="{Binding EditSlipRemarks, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="（任意）"
                             MaxLength="200">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding RemarksEnterCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>

            </StackPanel>
        </Border>

        <!-- ===== 明細DataGrid ===== -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"    />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid x:Name="LinesGrid"
                      Grid.Row="0"
                      ItemsSource="{Binding Lines}"
                      SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      Margin="4,4,4,0">

                <DataGrid.Columns>
                    <!-- 行番号 (readonly) -->
                    <DataGridTextColumn Header="行"
                                        Binding="{Binding LineNo}"
                                        IsReadOnly="True"
                                        Width="36">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <!-- 商品コード: Space キーで検索ダイアログを開く -->
                    <DataGridTemplateColumn Header="商品コード" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ProductCode}" Padding="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox h:FocusHelper.MoveNextOnEnter="True"
                                         Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"
                                         mah:TextBoxHelper.Watermark="コード">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Space"
                                                    Command="{Binding DataContext.OpenProductLookupCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <KeyBinding Key="Return"
                                                    Command="{Binding DataContext.LookupProductByCodeCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- 商品名 (readonly) -->
                    <DataGridTextColumn Header="商品名"
                                        Binding="{Binding ProductName}"
                                        IsReadOnly="True"
                                        Width="*">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <!-- 数量 -->
                    <DataGridTextColumn Header="数量"
                                        Binding="{Binding Quantity, StringFormat={}{0:0.##}}"
                                        Width="72">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="Padding" Value="4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 単価 -->
                    <DataGridTextColumn Header="単価"
                                        Binding="{Binding UnitPrice, StringFormat={}{0:N0}}"
                                        Width="88">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="Padding" Value="4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 金額 (readonly) -->
                    <DataGridTextColumn Header="金額"
                                        Binding="{Binding LineAmount, StringFormat={}{0:N0}}"
                                        IsReadOnly="True"
                                        Width="96">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="Padding" Value="4,0" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <!-- 税種別 -->
                    <DataGridTemplateColumn Header="税種別" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TaxType.TaxTypeName}"
                                           Padding="4,0"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.TaxTypes,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding TaxType}"
                                          DisplayMemberPath="TaxTypeName" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- 税率 (readonly) -->
                    <DataGridTextColumn Header="税率"
                                        Binding="{Binding AppliedTaxRateDisplay}"
                                        IsReadOnly="True"
                                        Width="56">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="Padding" Value="4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <!-- 行税額 (readonly) -->
                    <DataGridTextColumn Header="税額"
                                        Binding="{Binding LineTaxAmount, StringFormat={}{0:N0}}"
                                        IsReadOnly="True"
                                        Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="Padding" Value="4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <!-- 行摘要 -->
                    <DataGridTextColumn Header="行摘要"
                                        Binding="{Binding LineRemarks}"
                                        Width="120" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 行操作ボタン -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="4,2,4,4">
                <Button Command="{Binding AddLineCommand}"
                        Content="行追加 (F2)"
                        ToolTip="明細行を追加します (F2)"
                        Padding="8,2"
                        Margin="0,0,4,0" />
                <Button Command="{Binding DeleteLineCommand}"
                        Content="行削除"
                        ToolTip="選択行を削除します"
                        Padding="8,2" />
            </StackPanel>
        </Grid>

        <!-- ===== フッター: 集計 + 操作ボタン ===== -->
        <Border Grid.Row="3"
                Padding="12,8"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="32"   />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*"    />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 税抜金額 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="《税抜金額》"
                               FontSize="11"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                               Margin="0,0,0,2" />
                    <TextBox Text="{Binding TaxExcludedTotal, StringFormat={}{0:N0}, Mode=OneWay}"
                             IsReadOnly="True"
                             TextAlignment="Right"
                             FontWeight="Bold"
                             FontSize="14"
                             Width="120" />
                </StackPanel>

                <!-- 消費税計 -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="《消費税計》"
                               FontSize="11"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                               Margin="0,0,0,2" />
                    <TextBox Text="{Binding TaxTotal, StringFormat={}{0:N0}, Mode=OneWay}"
                             IsReadOnly="True"
                             TextAlignment="Right"
                             FontWeight="Bold"
                             FontSize="14"
                             Width="120" />
                </StackPanel>

                <!-- 合計ブロック (外税/内税/合計) -->
                <Border Grid.Column="4"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                        BorderThickness="1"
                        Padding="8,4"
                        Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"  />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4"    />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4"    />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="（外税）"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding ExternalTaxTotal, StringFormat={}{0:N0}, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextAlignment="Right" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="合計"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding GrandTotal, StringFormat={}{0:N0}, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextAlignment="Right"
                                 FontWeight="Bold"
                                 FontSize="14"
                                 Foreground="{DynamicResource MahApps.Brushes.Accent}" />

                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="（内税）"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 Text="{Binding InternalTaxTotal, StringFormat={}{0:N0}, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextAlignment="Right" />
                    </Grid>
                </Border>

                <!-- 操作ボタン（縦並び: 保存 / 印刷 / 削除） -->
                <StackPanel Grid.Column="5"
                            Orientation="Vertical"
                            VerticalAlignment="Center"
                            Width="110">
                    <Button Command="{Binding SaveCommand}"
                            Content="保存 (F10)"
                            ToolTip="伝票を保存します (F10)"
                            Margin="0,0,0,4"
                            Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" />
                    <Button Command="{Binding PrintCommand}"
                            Content="印刷 (F11)"
                            ToolTip="表示中の伝票を印刷します (F11)"
                            Margin="0,0,0,4" />
                    <Button Command="{Binding DeleteSlipCommand}"
                            Content="削除 (F8)"
                            ToolTip="この伝票を削除します (F8)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== StatusBar ===== -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</mah:MetroWindow>
