<Application x:Class="bmcs_app.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:bmcs_app.Converters"
             ShutdownMode="OnLastWindowClose">
    <!--
        StartupUri は指定しない。最初のウィンドウは DI 経由で WindowService が開く
        （App.xaml.cs の OnStartup）。

        ShutdownMode: 売上入力と受注入力などを同時に開く運用のため、
        メインメニューを閉じても他の画面が開いている間はアプリを終了させない。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    MahApps.Metro のテーマ。実行時のテーマ切替は行わないため
                    ThemeManager は使わず静的にマージする（暫定設定。docs/architecture.md 12章）。
                -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml" />
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/CommonControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <conv:EnumDisplayConverter x:Key="EnumDisplayConverter" />
            <conv:MenuAccentColorConverter x:Key="MenuAccentColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
