<mah:MetroWindow x:Class="bmcs_app.Views.Billing.DetailInvoiceIssueWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                 Title="bmcs_app - 明細請求書発行"
                 Height="720" Width="1180"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False">
    <!--
        TODO.md 6-3／6-4。都度得意先（内税明細単位）の未請求かつ消込完了でない売上明細行を選び、
        明細請求書を発行する。レイアウトはデモ（bmcs_app.LineInvoice）の2ペイン構成を踏襲。
        一覧を持たず、明細請求書No.を直接入力して既存分を読み込む方式（得意先／商品マスタ・
        締め解除処理と同じコード直接入力方式）。既存分は読み取り専用表示（訂正の概念が無いため）。
        取消（F8、6-4）は発行済みを読み込んだときのみ有効。印刷は10-3／10-5の範囲のため枠のみ用意し無効化する。
    -->
    <mah:MetroWindow.InputBindings>
        <KeyBinding Key="F3"  Command="{Binding NewCommand}" />
        <KeyBinding Key="F8"  Command="{Binding CancelCommand}" />
        <KeyBinding Key="F10" Command="{Binding IssueCommand}" />
    </mah:MetroWindow.InputBindings>

    <Grid beh:EnterKeyNavigationBehavior.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- ToolBar -->
            <RowDefinition Height="Auto" /> <!-- ヘッダー -->
            <RowDefinition Height="*" />    <!-- 候補 / 明細 -->
            <RowDefinition Height="Auto" /> <!-- フッター -->
            <RowDefinition Height="Auto" /> <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- ===== ToolBar ===== -->
        <ToolBar Grid.Row="0" ToolBarTray.IsLocked="True">
            <Button Command="{Binding NewCommand}"
                    Content="新規 (F3)"
                    ToolTip="新規明細請求書を作成します (F3)" />
            <Separator />
            <Button Command="{Binding CancelCommand}" Content="削除 (F8)" ToolTip="明細請求書を取消します (F8)" />
            <Button Content="印刷 (F11)" IsEnabled="False" ToolTip="帳票基盤・請求書実装（TODO.md 10-3／10-5、未実装）" />
        </ToolBar>

        <!-- ===== ヘッダー ===== -->
        <Border Grid.Row="1"
                Padding="12,8"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource MahApps.Brushes.Gray10}">
            <StackPanel>

                <!-- 行1: 明細請求書No. / 請求日付 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="請求書No." VerticalAlignment="Center" />
                    <TextBox x:Name="DetailInvoiceNumberBox"
                             Grid.Column="1"
                             beh:FocusBehavior.IsInitialFocus="True"
                             Text="{Binding DetailInvoiceNumberQuery, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="自動採番（SPACEで検索、既存分はEnterで読込）"
                             mah:TextBoxHelper.ClearTextButton="True"
                             MaxLength="20"
                             HorizontalAlignment="Left"
                             Width="200"
                             ToolTip="既存の明細請求書No.を入力してEnterで読み込む（読み取り専用表示）。Spaceで検索モーダルを開く">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Space"  Command="{Binding OpenDetailInvoiceSearchCommand}" />
                            <KeyBinding Key="Return" Command="{Binding LookupCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <TextBlock Grid.Column="3" Text="請求日付" VerticalAlignment="Center" />
                    <DatePicker Grid.Column="4"
                                mah:ControlsHelper.IsReadOnly="{Binding IsExistingLoaded}"
                                beh:FocusBehavior.FocusKey="IssueDate"
                                SelectedDate="{Binding IssueDate}" />
                </Grid>

                <!-- 行2: 得意先 -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="得意先" VerticalAlignment="Center" />
                    <TextBox x:Name="CustomerCodeBox"
                             Grid.Column="1"
                             IsReadOnly="{Binding IsExistingLoaded}"
                             Text="{Binding CustomerCode, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="コード（SPACEで検索）">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Space"  Command="{Binding OpenCustomerSearchCommand}" />
                            <KeyBinding Key="Return" Command="{Binding LookupCustomerByCodeCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBox Grid.Column="3"
                             Text="{Binding CustomerName, Mode=OneWay}"
                             IsReadOnly="True"
                             IsTabStop="False"
                             Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                </Grid>

                <!-- 行3: 宛名 -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="宛名" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             IsReadOnly="{Binding IsExistingLoaded}"
                             Text="{Binding AddresseeName, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="請求書に印字する宛名（得意先名を上書き可）"
                             ToolTip="学校のクラス・先生等の宛名を都度変更する場合はここを直接書き換える（C-9・2026-09-10確定）"
                             MaxLength="60" />
                </Grid>

            </StackPanel>
        </Border>

        <!-- ===== 候補 / 明細（2ペイン） ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="1.1*" MinWidth="480" />
            </Grid.ColumnDefinitions>

            <!-- 左: 取込候補（未請求の売上明細） -->
            <Grid Grid.Column="0" Margin="8,8,4,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="取込候補（未請求かつ消込完了でない売上明細）" FontWeight="Bold" Margin="0,0,0,4" />

                <ListView Grid.Row="1"
                          ItemsSource="{Binding Candidates}"
                          SelectedItem="{Binding SelectedCandidate}"
                          beh:RowActivationBehavior.Command="{Binding AddCandidateCommand}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="伝票No." Width="100" DisplayMemberBinding="{Binding SalesSlipNumber}" />
                            <GridViewColumn Header="売上日" Width="85" DisplayMemberBinding="{Binding SlipDate}" />
                            <GridViewColumn Header="区分" Width="55">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SlipType, Converter={StaticResource EnumDisplayConverter}}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="商品コード" Width="85" DisplayMemberBinding="{Binding ProductCode}" />
                            <GridViewColumn Header="商品名" Width="140" DisplayMemberBinding="{Binding ProductName}" />
                            <GridViewColumn Header="数量" Width="60" DisplayMemberBinding="{Binding Quantity, StringFormat={}{0:N0}}" />
                            <GridViewColumn Header="金額（税込）" Width="95" DisplayMemberBinding="{Binding Amount, StringFormat={}{0:N0}}" />
                            <GridViewColumn Header="うち消費税" Width="85" DisplayMemberBinding="{Binding TaxAmount, StringFormat={}{0:N0}}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="選択した行を追加 ▶"
                            Command="{Binding AddCandidateCommand}"
                            CommandParameter="{Binding SelectedCandidate}"
                            Padding="8,4" />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource MahApps.Brushes.Gray8}" />

            <!-- 右: 請求書明細 -->
            <Grid Grid.Column="2" Margin="4,8,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="請求書明細" FontWeight="Bold" Margin="0,0,0,4" />

                <ListView Grid.Row="1"
                          ItemsSource="{Binding Lines}"
                          SelectedItem="{Binding SelectedLine}"
                          beh:RowActivationBehavior.Command="{Binding RemoveLineCommand}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="伝票No." Width="100" DisplayMemberBinding="{Binding SalesSlipNumber}" />
                            <GridViewColumn Header="商品名" Width="150" DisplayMemberBinding="{Binding ProductName}" />
                            <GridViewColumn Header="数量" Width="55" DisplayMemberBinding="{Binding Quantity, StringFormat={}{0:N0}}" />
                            <GridViewColumn Header="単価" Width="75" DisplayMemberBinding="{Binding UnitPrice, StringFormat={}{0:N0}}" />
                            <GridViewColumn Header="金額（税込）" Width="95" DisplayMemberBinding="{Binding Amount, StringFormat={}{0:N0}}" />
                            <GridViewColumn Header="うち消費税" Width="85" DisplayMemberBinding="{Binding TaxAmount, StringFormat={}{0:N0}}" />
                            <GridViewColumn Header="行摘要" Width="120" DisplayMemberBinding="{Binding LineRemarks}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="◀ 除外"
                            Command="{Binding RemoveLineCommand}"
                            CommandParameter="{Binding SelectedLine}"
                            Padding="8,4" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== フッター ===== -->
        <Grid Grid.Row="3" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="《税抜金額》" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Text="{Binding TaxExcludedTotal, StringFormat={}{0:N0}}" HorizontalAlignment="Right" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="《消費税計》" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Text="{Binding TaxTotal, StringFormat={}{0:N0}}" HorizontalAlignment="Right" FontWeight="Bold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="合計" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:N0}}"
                               HorizontalAlignment="Right" FontWeight="Bold" FontSize="16"
                               Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="2"
                    Content="発行 (F10)"
                    Command="{Binding IssueCommand}"
                    ToolTip="明細請求書を発行します (F10)"
                    Padding="16,6"
                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" />
        </Grid>

        <!-- ===== StatusBar ===== -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="処理中..." Foreground="OrangeRed"
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</mah:MetroWindow>
