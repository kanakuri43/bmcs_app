<mah:MetroWindow x:Class="bmcs_app.Views.Billing.BillingReleaseWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                 Title="bmcs_app - 締め解除処理"
                 Height="640" Width="980"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False">
    <!--
        TODO.md 6-2（2026-09-15改訂）。指定した請求日の確定済みbillingをまとめて解除済にし、
        紐付く売上を未請求へ戻す。請求締め処理（BillingClosingWindow）とは別画面とする
        （C-8・2026-09-10確定）。入力は請求日のみで、対象を一覧表示してから一括で解除する
        （BillingClosingWindowと同様、プレビューはボタンを持たず条件変更時に自動再取得する）。
        対象の中に解除できないものが1件でもあれば解除実行を無効化する（All-or-nothing）。
    -->
    <mah:MetroWindow.InputBindings>
        <KeyBinding Key="F8" Command="{Binding ReleaseCommand}" />
    </mah:MetroWindow.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 条件 -->
            <RowDefinition Height="*" />    <!-- 一覧 -->
            <RowDefinition Height="Auto" /> <!-- 合計・操作 -->
            <RowDefinition Height="Auto" /> <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- ===== 条件 ===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="請求日" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker Width="120" Margin="0,0,16,0"
                        beh:FocusBehavior.IsInitialFocus="True"
                        SelectedDate="{Binding BillingDate}" />

            <Button Content="解除実行 (F8)" Command="{Binding ReleaseCommand}" Padding="16,6" />
        </StackPanel>

        <!-- ===== 一覧 ===== -->
        <ListView Grid.Row="1" ItemsSource="{Binding Results}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="請求番号" Width="100" DisplayMemberBinding="{Binding BillingNumber}" />
                    <GridViewColumn Header="得意先コード" Width="90" DisplayMemberBinding="{Binding CustomerCode}" />
                    <GridViewColumn Header="得意先名" Width="160" DisplayMemberBinding="{Binding CustomerName}" />
                    <GridViewColumn Header="税区分" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TaxUnit, Converter={StaticResource EnumDisplayConverter}}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="締め年月" Width="80" DisplayMemberBinding="{Binding ClosingYearMonth}" />
                    <GridViewColumn Header="前回残高" Width="100" DisplayMemberBinding="{Binding PreviousBalance, StringFormat={}{0:N0}}" />
                    <GridViewColumn Header="入金額" Width="100" DisplayMemberBinding="{Binding ReceiptAmount, StringFormat={}{0:N0}}" />
                    <GridViewColumn Header="売上額" Width="100" DisplayMemberBinding="{Binding SalesAmount, StringFormat={}{0:N0}}" />
                    <GridViewColumn Header="消費税" Width="90" DisplayMemberBinding="{Binding TaxAmount, StringFormat={}{0:N0}}" />
                    <GridViewColumn Header="今回請求額" Width="110" DisplayMemberBinding="{Binding CurrentBillingAmount, StringFormat={}{0:N0}}" />
                    <GridViewColumn Header="確定日時" Width="130" DisplayMemberBinding="{Binding ConfirmedAt, StringFormat={}{0:yyyy/MM/dd HH:mm}}" />
                    <GridViewColumn Header="備考" Width="220" DisplayMemberBinding="{Binding BlockReason}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- ===== 合計 ===== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="対象の今回請求額 合計:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="{Binding TotalCurrentBillingAmount, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" />
            <TextBlock Text="処理中..." VerticalAlignment="Center" Margin="16,0,0,0" Foreground="OrangeRed"
                       Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!-- ===== StatusBar ===== -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</mah:MetroWindow>
