<mah:MetroWindow x:Class="bmcs_app.Views.Billing.BillingClosingWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                 Title="bmcs_app - 請求締め処理"
                 Height="640" Width="980"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False">
    <!--
        締め得意先（tax_unit=請求単位／伝票単位）の確定済み請求データ一覧と、締め実行の起点となる画面。
        締めの実行（締日／個別指定の選択・請求日の入力）は「締め確定」ボタンで開く締確定ダイアログで行う。
        この画面の入力は一覧の抽出条件である請求日のみ。
        一覧は「これから締めたらどうなるか」のプレビューではなく、billingsに実在する確定済み
        請求データを請求日だけで抽出したもの。未確定の請求日を選ぶと0件になる。
        一覧は拡張選択（Ctrl/Shiftクリック。チェックボックス列は持たない）で複数行を選べ、
        選択行をまとめて印刷できる（請求書の再発行手段。docs/design_document.md 9章参照）。
        プレビューが無くなった分、締確定ダイアログで実行前に確認を挟む。
    -->
    <mah:MetroWindow.InputBindings>
        <KeyBinding Key="F10" Command="{Binding ConfirmCommand}" />
        <KeyBinding Key="F11" Command="{Binding PrintCommand}" />
    </mah:MetroWindow.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 条件 -->
            <RowDefinition Height="*" />    <!-- 一覧 -->
            <RowDefinition Height="Auto" /> <!-- 合計・操作 -->
            <RowDefinition Height="Auto" /> <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- ===== 条件 ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <!-- 締め確定は右上。締確定ダイアログを開く。 -->
            <Button DockPanel.Dock="Right" Content="締め確定 (F10)" Command="{Binding ConfirmCommand}" Padding="16,6" />

            <!-- 請求日の選択: 年（4桁）→その年に請求締め済みの日付。年が変わると日付の選択肢と一覧が自動で更新される。 -->
            <TextBlock DockPanel.Dock="Left" Text="年" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox DockPanel.Dock="Left" Width="60" MaxLength="4" Margin="0,0,16,0"
                     beh:FocusBehavior.IsInitialFocus="True"
                     Text="{Binding YearText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock DockPanel.Dock="Left" Text="請求日" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox DockPanel.Dock="Left" Width="140"
                      ItemsSource="{Binding BillingDates}"
                      SelectedItem="{Binding ClosingDate}"
                      ItemStringFormat="yyyy/MM/dd" />
        </DockPanel>

        <!-- ===== 一覧 ===== -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding Results}"
                  SelectionMode="Extended"
                  beh:MultiSelectionBehavior.SelectedItems="{Binding SelectedResults}"
                  beh:RowActivationBehavior.Command="{Binding PrintCommand}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="請求番号" Width="100" DisplayMemberBinding="{Binding BillingNumber}" />
                    <GridViewColumn Header="得意先コード" Width="90" DisplayMemberBinding="{Binding CustomerCode}" />
                    <GridViewColumn Header="得意先名" Width="150" DisplayMemberBinding="{Binding CustomerName}" />
                    <GridViewColumn Header="税区分" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TaxUnit, Converter={StaticResource EnumDisplayConverter}}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="締め年月" Width="80" DisplayMemberBinding="{Binding ClosingYearMonth}" />
                    <GridViewColumn Header="前回残高" Width="95" DisplayMemberBinding="{Binding PreviousBalance, StringFormat={}{0:N0}}" />
                    <GridViewColumn Header="入金額" Width="95" DisplayMemberBinding="{Binding ReceiptAmount, StringFormat={}{0:N0}}" />
                    <GridViewColumn Header="売上額" Width="95" DisplayMemberBinding="{Binding SalesAmount, StringFormat={}{0:N0}}" />
                    <GridViewColumn Header="消費税" Width="85" DisplayMemberBinding="{Binding TaxAmount, StringFormat={}{0:N0}}" />
                    <GridViewColumn Header="今回請求額" Width="105" DisplayMemberBinding="{Binding CurrentBillingAmount, StringFormat={}{0:N0}}" />
                    <GridViewColumn Header="確定日時" Width="130" DisplayMemberBinding="{Binding ConfirmedAt, StringFormat={}{0:yyyy/MM/dd HH:mm}}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- ===== 合計・操作 ===== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="今回請求額 合計:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding TotalCurrentBillingAmount, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBlock Text="処理中..." VerticalAlignment="Center" Margin="16,0,0,0" Foreground="OrangeRed"
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="選択行を印刷 (F11)"
                    Command="{Binding PrintCommand}"
                    ToolTip="選択した請求書をまとめて印刷します（複数選択可。F11）"
                    Padding="12,6" />
        </Grid>

        <!-- ===== StatusBar ===== -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</mah:MetroWindow>
