<mah:MetroWindow x:Class="bmcs_app.Views.Master.ProductMasterWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                 Title="商品マスタ"
                 Height="600" Width="640"
                 ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False">
    <Grid Margin="16" beh:EnterKeyNavigationBehavior.IsEnabled="True"
          beh:ImeAwareSpaceKeyBindingBehavior.IsEnabled="True">
        <!-- 詳細フォーム -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="基本情報" FontWeight="Bold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="商品コード" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             beh:FocusBehavior.IsInitialFocus="True"
                             Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="コード（SPACEで検索）"
                             ToolTip="商品コードを直接入力してEnterで読み込む。未登録のコードは新規登録として扱う。Spaceで検索モーダルを開く"
                             HorizontalAlignment="Left" Width="160" Margin="0,0,0,8">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Space"  Command="{Binding OpenProductSearchCommand}" />
                            <KeyBinding Key="Return" Command="{Binding LookupProductByCodeCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="商品名" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" beh:FocusBehavior.FocusKey="Name" Text="{Binding ProductName}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="カナ" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ProductNameKana}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="規格" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Specification}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="単位" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding UnitName}" Margin="0,0,0,8" />
                </Grid>

                <TextBlock Text="単価・税区分" FontWeight="Bold" Margin="0,16,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="外税単価（税抜）" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource AmountTextBoxStyle}"
                             Text="{Binding StandardUnitPriceExclTax}" Width="140" HorizontalAlignment="Left" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="内税単価（税込）" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource AmountTextBoxStyle}"
                             Text="{Binding StandardUnitPriceInclTax}" Width="140" HorizontalAlignment="Left" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="標準原価" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource AmountTextBoxStyle}"
                             Text="{Binding StandardCostPrice}" Width="140" HorizontalAlignment="Left" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="税種別区分" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Width="140" HorizontalAlignment="Left" Margin="0,0,0,8"
                              ItemsSource="{Binding TaxCategoryOptions}"
                              SelectedItem="{Binding TaxCategory}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="保存" Command="{Binding SaveCommand}" Padding="16,6" Margin="0,0,12,0" />
                    <Button Content="キャンセル" Command="{Binding NewProductCommand}" Padding="16,6" Margin="0,0,12,0" />
                    <Button Content="無効化" Command="{Binding DeactivateCommand}" Padding="16,6" Margin="0,0,12,0" />
                    <TextBlock Text="処理中..." VerticalAlignment="Center" Foreground="OrangeRed"
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="Gray" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</mah:MetroWindow>
