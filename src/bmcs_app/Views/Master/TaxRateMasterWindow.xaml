<mah:MetroWindow x:Class="bmcs_app.Views.Master.TaxRateMasterWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="消費税率マスタ"
                 Height="520" Width="780"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <DataGrid Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" CanUserAddRows="False" Margin="0,0,16,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="施行日" Binding="{Binding EffectiveDate, StringFormat={}{0:yyyy/MM/dd}}" Width="*" />
                <DataGridTextColumn Header="標準税率（%）" Binding="{Binding StandardTaxRate, StringFormat={}{0:0.##}}" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="軽減税率（%）" Binding="{Binding ReducedTaxRate, StringFormat={}{0:0.##}}" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1" Width="280">
            <TextBlock Text="編集（一覧で選ぶと修正・削除、［新規］で追加）" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock Text="施行日（追加のときだけ入力できます）" TextWrapping="Wrap" Margin="0,0,0,2" />
            <DatePicker SelectedDate="{Binding EffectiveDate}" IsEnabled="{Binding IsNew}"
                        HorizontalAlignment="Left" Width="140" Margin="0,0,0,8" />
            <TextBlock Text="標準税率（%）" Margin="0,0,0,2" />
            <TextBox Text="{Binding StandardTaxRateText}" TextAlignment="Right"
                     Width="80" HorizontalAlignment="Left" Margin="0,0,0,8" />
            <TextBlock Text="軽減税率（%）" Margin="0,0,0,2" />
            <TextBox Text="{Binding ReducedTaxRateText}" TextAlignment="Right"
                     Width="80" HorizontalAlignment="Left" Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal">
                <Button Content="新規" Command="{Binding NewCommand}" Padding="16,6" Margin="0,0,12,0" />
                <Button Content="保存" Command="{Binding SaveCommand}" Padding="16,6" Margin="0,0,12,0" />
                <Button Content="削除" Command="{Binding DeleteCommand}" Padding="16,6" Margin="0,0,12,0" />
                <TextBlock Text="処理中..." VerticalAlignment="Center" Foreground="OrangeRed"
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="Gray" />
            <TextBlock TextWrapping="Wrap" Margin="0,16,0,0" Foreground="Gray"
                       Text="伝票（受注・売上）がある期間の税率は、変更も削除もできません。施行日を直したいときは、削除してから追加し直します。" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
