<mah:MetroWindow x:Class="bmcs_app.Views.Master.CustomerMasterWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                 Title="得意先マスタ"
                 Height="1000" Width="640"
                 ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False">
    <Grid Margin="16" beh:EnterKeyNavigationBehavior.IsEnabled="True"
          beh:ImeAwareSpaceKeyBindingBehavior.IsEnabled="True">
        <!-- 詳細フォーム -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="基本情報" FontWeight="Bold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="得意先コード" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             beh:FocusBehavior.IsInitialFocus="True"
                             Text="{Binding CustomerCode, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="コード（SPACEで検索）"
                             ToolTip="得意先コードを直接入力してEnterで読み込む。未登録のコードは新規登録として扱う。Spaceで検索モーダルを開く"
                             HorizontalAlignment="Left" Width="160" Margin="0,0,0,8">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Space"  Command="{Binding OpenCustomerSearchCommand}" />
                            <KeyBinding Key="Return" Command="{Binding LookupCustomerByCodeCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="得意先名" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" beh:FocusBehavior.FocusKey="Name" Text="{Binding CustomerName}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="カナ" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CustomerNameKana}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="郵便番号" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PostalCode}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="住所1" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Address1}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="住所2" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Address2}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="電話番号" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding PhoneNumber}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="FAX番号" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding FaxNumber}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="得意先担当者名" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ContactPersonName}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="営業担当社員コード" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding SalesEmployeeCode}" Margin="0,0,0,8" />
                </Grid>

                <TextBlock Text="取引条件（登録後は変更不可）" FontWeight="Bold" Margin="0,16,0,8" />
                <StackPanel IsEnabled="{Binding IsClosingTypeEditable}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Content="都度取引"
                                     IsChecked="{Binding TransactionType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=OneOff}"
                                     Margin="0,0,16,0" VerticalAlignment="Center" />
                        <RadioButton Content="締め取引"
                                     IsChecked="{Binding TransactionType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Closing}"
                                     VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Visibility="{Binding IsClosingTransaction, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="締日（1〜31、末日=99）" Margin="0,0,12,8" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ClosingDayText}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="税区分" Margin="0,0,12,8" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,0,0,8"
                                  ItemsSource="{Binding ClosingTaxUnitOptions}"
                                  SelectedItem="{Binding ClosingTaxUnit}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>

                <TextBlock Text="請求集約" FontWeight="Bold" Margin="0,16,0,8" />
                <Grid IsEnabled="{Binding IsBillingCustomerEditable}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="請求得意先コード" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Text="{Binding BillingCustomerCodeText, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="空欄＝自分自身（SPACEで検索）"
                                 ToolTip="他の得意先コードを指定すると、その得意先（請求集約先）にまとめて請求される。空欄なら従来どおり単独で請求"
                                 Width="160">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Space"  Command="{Binding OpenBillingCustomerSearchCommand}" />
                                <KeyBinding Key="Return" Command="{Binding LookupBillingCustomerByCodeCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding BillingCustomerName}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="表示設定" FontWeight="Bold" Margin="0,16,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="端数区分（登録後は変更不可）" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,0,0,8"
                              beh:FocusBehavior.FocusKey="RoundingType"
                              IsEnabled="{Binding IsClosingTypeEditable}"
                              ItemsSource="{Binding RoundingTypeOptions}"
                              SelectedItem="{Binding RoundingType}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <CheckBox Grid.Row="1" Grid.Column="1" Content="請求書に代表者印字する"
                              beh:FocusBehavior.FocusKey="PrintRepresentative"
                              IsChecked="{Binding PrintRepresentativeFlag}" Margin="0,0,0,8" />
                </Grid>

                <TextBlock Text="請求書の振込先口座（最大2件）" FontWeight="Bold" Margin="0,16,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="振込先口座1" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Text="{Binding BankAccountCode1Text, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="空欄＝印字しない（SPACEで検索）"
                                 ToolTip="請求書の自社名の下に印字する振込先口座。空欄なら印字しない"
                                 Width="160">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Space"  Command="{Binding OpenBankAccount1SearchCommand}" />
                                <KeyBinding Key="Return" Command="{Binding LookupBankAccount1ByCodeCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding BankAccount1Label}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="振込先口座2" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Text="{Binding BankAccountCode2Text, UpdateSourceTrigger=PropertyChanged}"
                                 beh:FocusBehavior.FocusKey="BankAccount2"
                                 mah:TextBoxHelper.Watermark="空欄＝印字しない（SPACEで検索）"
                                 ToolTip="請求書の自社名の下に印字する振込先口座。空欄なら印字しない"
                                 Width="160">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Space"  Command="{Binding OpenBankAccount2SearchCommand}" />
                                <KeyBinding Key="Return" Command="{Binding LookupBankAccount2ByCodeCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding BankAccount2Label}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="新規" Command="{Binding NewCustomerCommand}" beh:FocusBehavior.FocusKey="NewButton" Padding="16,6" Margin="0,0,12,0" />
                    <Button Content="保存" Command="{Binding SaveCommand}" Padding="16,6" Margin="0,0,12,0" />
                    <Button Content="無効化" Command="{Binding DeactivateCommand}" Padding="16,6" Margin="0,0,12,0" />
                    <TextBlock Text="処理中..." VerticalAlignment="Center" Foreground="OrangeRed"
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="Gray" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</mah:MetroWindow>
