<mah:MetroWindow x:Class="bmcs_app.Views.Master.SupplierMasterWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                 Title="仕入先マスタ"
                 Height="560" Width="640"
                 ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False">
    <Grid Margin="16" beh:EnterKeyNavigationBehavior.IsEnabled="True"
          beh:ImeAwareSpaceKeyBindingBehavior.IsEnabled="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="基本情報" FontWeight="Bold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="仕入先コード" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox beh:FocusBehavior.IsInitialFocus="True"
                                 Text="{Binding SupplierCode, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="コード（SPACEで検索）"
                                 ToolTip="仕入先コードを直接入力してEnterで読み込む。未登録のコードは新規登録として扱う。Spaceで検索モーダルを開く"
                                 Width="160">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Space"  Command="{Binding OpenSupplierSearchCommand}" />
                                <KeyBinding Key="Return" Command="{Binding LookupSupplierByCodeCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding NewCodeMessage}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   FontWeight="Bold" Foreground="OrangeRed" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="仕入先名" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" beh:FocusBehavior.FocusKey="Name" Text="{Binding SupplierName}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="仕入先名カナ" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SupplierNameKana}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="郵便番号" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PostalCode}"
                             HorizontalAlignment="Left" Width="120" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="住所1" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Address1}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="住所2" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Address2}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="電話番号" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding PhoneNumber}"
                             HorizontalAlignment="Left" Width="160" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="FAX番号" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding FaxNumber}"
                             HorizontalAlignment="Left" Width="160" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="先方担当者" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ContactPersonName}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="備考" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Remarks}" Margin="0,0,0,8" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="保存" Command="{Binding SaveCommand}" Padding="16,6" Margin="0,0,12,0" />
                    <Button Content="キャンセル" Command="{Binding NewSupplierCommand}" Padding="16,6" Margin="0,0,12,0" />
                    <Button Content="無効化" Command="{Binding DeactivateCommand}" Padding="16,6" Margin="0,0,12,0" />
                    <TextBlock Text="処理中..." VerticalAlignment="Center" Foreground="OrangeRed"
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="Gray" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</mah:MetroWindow>
