<mah:MetroWindow x:Class="bmcs_app.Views.Master.CompanyInfoSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="自社情報"
                 Height="520" Width="560"
                 ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False">
    <Grid Margin="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="基本情報" FontWeight="Bold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="会社名" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CompanyName}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="登録番号" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding InvoiceRegistrationNumber}"
                             mah:TextBoxHelper.Watermark="T + 13桁"
                             ToolTip="適格請求書発行事業者の登録番号（T + 13桁の数字）。法定記載事項"
                             HorizontalAlignment="Left" Width="200" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="郵便番号" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PostalCode}"
                             HorizontalAlignment="Left" Width="120" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="住所1" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Address1}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="住所2" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Address2}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="電話番号" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding PhoneNumber}"
                             HorizontalAlignment="Left" Width="160" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="FAX番号" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding FaxNumber}"
                             HorizontalAlignment="Left" Width="160" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="代表者名" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding RepresentativeName}" Margin="0,0,0,8" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="保存" Command="{Binding SaveCommand}" Padding="16,6" Margin="0,0,12,0" />
                    <TextBlock Text="処理中..." VerticalAlignment="Center" Foreground="OrangeRed"
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="Gray" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</mah:MetroWindow>
