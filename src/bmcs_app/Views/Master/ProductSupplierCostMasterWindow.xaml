<mah:MetroWindow x:Class="bmcs_app.Views.Master.ProductSupplierCostMasterWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                 Title="仕入先／商品／原価マスタ"
                 Height="640" Width="780" MinHeight="420" MinWidth="600"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダ（Enter での項目移動はここだけ。一覧のセル編集中の Enter を横取りしないため） -->
        <Grid Grid.Row="0" beh:EnterKeyNavigationBehavior.IsEnabled="True"
              beh:ImeAwareSpaceKeyBindingBehavior.IsEnabled="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="仕入先" Margin="0,0,12,8" VerticalAlignment="Center" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox beh:FocusBehavior.IsInitialFocus="True"
                         Text="{Binding SupplierCode, UpdateSourceTrigger=PropertyChanged}"
                         mah:TextBoxHelper.Watermark="コード（SPACEで検索）"
                         ToolTip="仕入先コードを入力してEnterで、その仕入先の商品一覧を読み込む。Spaceで仕入先検索モーダルを開く"
                         Width="200">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Space"  Command="{Binding SelectSupplierCommand}" />
                        <KeyBinding Key="Return" Command="{Binding LookupSupplierByCodeCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="..." Width="28" Margin="4,0,0,0" Command="{Binding SelectSupplierCommand}" />
                <TextBlock Text="{Binding SupplierName}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="商品の絞り込み" Margin="0,0,12,8" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Margin="0,0,0,8" Width="300"
                     beh:FocusBehavior.FocusKey="Filter"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     mah:TextBoxHelper.Watermark="商品コード・商品名の一部"
                     ToolTip="商品コードまたは商品名の一部で一覧を絞り込む。絞り込んでも、入力した内容は残る" />
        </Grid>

        <!-- 一覧：入力できるのは原価だけ -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding RowsView}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" CanUserReorderColumns="False"
                  SelectionUnit="Cell" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Resources>
                <Style x:Key="RightAlignedText" TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                </Style>
                <Style x:Key="RightAlignedEdit" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="商品コード" Binding="{Binding ProductCode}" IsReadOnly="True" Width="Auto" />
                <DataGridTextColumn Header="商品名" Binding="{Binding ProductName}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="標準原価" Binding="{Binding StandardCostPrice, StringFormat={}{0:N0}}" IsReadOnly="True"
                                    ElementStyle="{StaticResource RightAlignedText}" Width="110" />
                <DataGridTextColumn Header="原価"
                                    Binding="{Binding CostText, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource RightAlignedText}"
                                    EditingElementStyle="{StaticResource RightAlignedEdit}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="登録" Command="{Binding SaveCommand}" Padding="16,6" Margin="0,0,12,0" />
                <TextBlock Text="処理中..." VerticalAlignment="Center" Foreground="OrangeRed"
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="空欄にして登録すると、この仕入先の原価は無効になり、伝票には標準原価が入ります。" VerticalAlignment="Center" Foreground="Gray" Margin="12,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="Gray" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
