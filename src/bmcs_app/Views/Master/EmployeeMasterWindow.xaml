<mah:MetroWindow x:Class="bmcs_app.Views.Master.EmployeeMasterWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                 Title="社員マスタ"
                 Height="420" Width="560"
                 ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False">
    <Grid Margin="16" beh:EnterKeyNavigationBehavior.IsEnabled="True"
          beh:ImeAwareSpaceKeyBindingBehavior.IsEnabled="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="基本情報" FontWeight="Bold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="社員コード" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             beh:FocusBehavior.IsInitialFocus="True"
                             Text="{Binding EmployeeCode, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="コード（SPACEで検索）"
                             ToolTip="社員コードを直接入力してEnterで読み込む。未登録のコードは新規登録として扱う。Spaceで検索モーダルを開く"
                             HorizontalAlignment="Left" Width="160" Margin="0,0,0,8">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Space"  Command="{Binding OpenEmployeeSearchCommand}" />
                            <KeyBinding Key="Return" Command="{Binding LookupEmployeeByCodeCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="社員名" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" beh:FocusBehavior.FocusKey="Name" Text="{Binding EmployeeName}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="カナ" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EmployeeNameKana}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="権限レベル" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PermissionLevelText}"
                             ToolTip="メニュー構成マスタの必要権限レベルと比較する数値（0〜255）"
                             HorizontalAlignment="Left" Width="80" Margin="0,0,0,8" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="保存" Command="{Binding SaveCommand}" Padding="16,6" Margin="0,0,12,0" />
                    <Button Content="キャンセル" Command="{Binding NewEmployeeCommand}" Padding="16,6" Margin="0,0,12,0" />
                    <Button Content="無効化" Command="{Binding DeactivateCommand}" Padding="16,6" Margin="0,0,12,0" />
                    <TextBlock Text="処理中..." VerticalAlignment="Center" Foreground="OrangeRed"
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="Gray" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</mah:MetroWindow>
