<mah:MetroWindow x:Class="bmcs_app.Views.Master.CustomerProductRateMasterWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                 Title="得意先／商品／定価掛率マスタ"
                 Height="400" Width="680"
                 ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False">
    <Grid Margin="16" beh:EnterKeyNavigationBehavior.IsEnabled="True"
          beh:ImeAwareSpaceKeyBindingBehavior.IsEnabled="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="基本情報" FontWeight="Bold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="得意先コード" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox beh:FocusBehavior.IsInitialFocus="True"
                                 Text="{Binding CustomerCode, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="得意先コード（SPACEで検索）"
                                 ToolTip="Spaceで得意先検索モーダルを開く。Enterでコードから得意先名を照会する"
                                 Width="200">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Space"  Command="{Binding OpenCustomerSearchCommand}" />
                                <KeyBinding Key="Return" Command="{Binding LookupCustomerByCodeCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding CustomerName}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="商品コード" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox beh:FocusBehavior.FocusKey="Product"
                                 Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="商品コード（SPACEで検索）"
                                 ToolTip="Spaceで商品検索モーダルを開く。Enterでコードから商品名を照会し、登録済みの定価掛率を読み込む"
                                 Width="200">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Space"  Command="{Binding OpenProductSearchCommand}" />
                                <KeyBinding Key="Return" Command="{Binding LookupProductByCodeCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding ProductName}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="定価掛率（%）" Margin="0,0,12,8" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox beh:FocusBehavior.FocusKey="Rate"
                                 Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="0〜100の整数"
                                 ToolTip="商品マスタの定価に掛ける率（パーセント）。整数で入力する。受注・売上入力で商品を選んだとき、定価×掛率が単価になる"
                                 HorizontalContentAlignment="Right" Width="140" />
                        <TextBlock Text="{Binding CatalogPriceNote}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="保存" Command="{Binding SaveCommand}" Padding="16,6" Margin="0,0,12,0" />
                    <Button Content="キャンセル" Command="{Binding NewRateCommand}" Padding="16,6" Margin="0,0,12,0" />
                    <Button Content="無効化" Command="{Binding DeactivateCommand}" Padding="16,6" Margin="0,0,12,0" />
                    <TextBlock Text="処理中..." VerticalAlignment="Center" Foreground="OrangeRed"
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="Gray" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</mah:MetroWindow>
