<mah:MetroWindow x:Class="bmcs_app.Views.Master.QueryRunnerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="bmcs_app - クエリ実行"
                 Height="640" Width="1100"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0" LastChildFill="False">
            <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding Queries}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedQuery}" />
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Params}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Name}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button DockPanel.Dock="Top" Content="実行" Command="{Binding RunCommand}" Padding="16,6" Margin="0,8,0,0" />
            <Button DockPanel.Dock="Top" Content="CSV保存" Command="{Binding SaveCsvCommand}" Padding="16,6" Margin="0,8,0,0" />
            <Button DockPanel.Dock="Bottom" Content="クエリファイル編集" Command="{Binding EditFileCommand}" Padding="16,6" />
        </DockPanel>

        <DataGrid Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ResultView}"
                  AutoGenerateColumns="True" AutoGeneratingColumn="ResultGrid_AutoGeneratingColumn"
                  IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="All" />
        <mah:ProgressRing Grid.Row="0" Grid.Column="1" Width="50" Height="50"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsActive="{Binding IsBusy}" />

        <StatusBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</mah:MetroWindow>
