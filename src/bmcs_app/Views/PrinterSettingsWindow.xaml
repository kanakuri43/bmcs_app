<mah:MetroWindow x:Class="bmcs_app.Views.PrinterSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    Title="プリンタ設定"
    Height="220" Width="520"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowTransitionsEnabled="False">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 納品書 -->
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="納品書"
                   VerticalAlignment="Center" />
        <ComboBox Grid.Row="0" Grid.Column="1"
                  ItemsSource="{Binding Printers}"
                  SelectedItem="{Binding DeliverySlipPrinter}" />

        <!-- 請求書 -->
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="請求書"
                   VerticalAlignment="Center" />
        <ComboBox Grid.Row="2" Grid.Column="1"
                  ItemsSource="{Binding Printers}"
                  SelectedItem="{Binding InvoicePrinter}" />

        <!-- 保存ボタン -->
        <Button Grid.Row="4" Grid.Column="1"
                Content="保存 (F10)"
                Command="{Binding SaveCommand}"
                Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                HorizontalAlignment="Right"
                Width="96" />

        <!-- ステータス -->
        <TextBlock Grid.Row="6" Grid.ColumnSpan="2"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource MahApps.Brushes.Accent}"
                   FontSize="11" />
    </Grid>

    <Window.InputBindings>
        <KeyBinding Key="F10" Command="{Binding SaveCommand}" />
    </Window.InputBindings>
</mah:MetroWindow>
