<mah:MetroWindow x:Class="bmcs_app.Views.Menu.MainMenuWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                 Title="販売管理"
                 Height="1000" Width="360"
                 MinHeight="600" MinWidth="380"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False"
                 ResizeMode="CanMinimize"
                 Background="#FFF3F5F8">
    <!--
        TODO.md 2-7。デザインモック（旧 MainMenuMockWindow）のC案＝リスト・アコーディオン型を
        採用し、メニュー構成マスタ（menu）駆動・権限フィルタ済みの内容を表示する（縦長ウィンドウ）。
    -->
    <mah:MetroWindow.Resources>

        <!-- カテゴリ内の機能項目（リーフ）の行ボタン -->
        <Style x:Key="ListRowButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF2B2F36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="#FFE8EAED" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AccentBar" Grid.Column="0" Background="Transparent" />
                                <TextBlock Grid.Column="1" Text="&#9656;" FontSize="11" Foreground="#FFB0B6C0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFF5F7FA" />
                                <Setter TargetName="AccentBar" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFF5F7FA" />
                                <Setter TargetName="AccentBar" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- カテゴリ見出しを折りたたむアコーディオン -->
        <Style x:Key="AccordionSectionStyle" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle"
                                          Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Cursor="Hand"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBg"
                                                Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                CornerRadius="8"
                                                Padding="14,10"
                                                Margin="0,10,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Chevron"
                                                           Text="&#9656;"
                                                           FontSize="13"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0"
                                                           RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                                <TextBlock Text="{TemplateBinding Content}" FontSize="14" FontWeight="Bold" Foreground="White" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBg" Property="Opacity" Value="0.85" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="0,0,0,4" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </mah:MetroWindow.Resources>

    <Grid Margin="24" beh:EnterKeyNavigationBehavior.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <!--
            <TextBlock Text="石山商店" FontSize="12" Foreground="#FF8A93A3" />
            <TextBlock Text="販売管理システム" FontSize="24" FontWeight="Bold" Foreground="#FF1F2430" Margin="0,0,0,12" />
            -->
            <Border Background="White" CornerRadius="8" Padding="14,8" BorderBrush="#FFE3E6EA" BorderThickness="1"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="15" Background="#FF1E88E5" Margin="0,0,10,0">
                        <TextBlock Text="{Binding EmployeeInitial}" Foreground="White" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding EmployeeName}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PermissionLevel, StringFormat=権限レベル {0}}" FontSize="11" Foreground="#FF8A93A3" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- メニュー本体（C案: リスト・アコーディオン型） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Style="{StaticResource AccordionSectionStyle}"
                                  Header="{Binding MenuName}"
                                  Tag="{Binding ColorIndex, Converter={StaticResource MenuAccentColorConverter}}"
                                  IsExpanded="True">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding MenuName}"
                                                Style="{StaticResource ListRowButtonStyle}"
                                                Tag="{Binding ColorIndex, Converter={StaticResource MenuAccentColorConverter}}"
                                                Command="{Binding DataContext.OpenMenuItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding ScreenKey}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- フッター -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#FFD9822B" TextWrapping="Wrap" />
            <TextBlock Text="処理中..." Foreground="OrangeRed"
                       Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Text="{Binding ConnectionInfo}" FontSize="10" Foreground="#FFB0B6C0" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
