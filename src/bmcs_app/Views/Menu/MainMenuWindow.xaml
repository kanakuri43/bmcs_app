<mah:MetroWindow x:Class="bmcs_app.Views.Menu.MainMenuWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                 Title="販売管理"
                 Width="1000" Height="720"
                 MinHeight="400" MinWidth="280"
                 WindowStartupLocation="Manual"
                 Left="0" Top="0"
                 WindowTransitionsEnabled="False"
                 Background="#FFF3F5F8">
    <!--
        カテゴリのカードを横に並べるタイル型。メニュー構成マスタ（menu）駆動・権限フィルタ済みの内容を
        全項目常時表示する。ウィンドウ幅に収まらないカードは WrapPanel で次の行へ折り返す。
    -->
    <mah:MetroWindow.Resources>

        <!-- カテゴリ内の機能項目（リーフ）の行ボタン -->
        <Style x:Key="ListRowButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF2B2F36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="#FFE8EAED" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AccentBar" Grid.Column="0" Background="Transparent" />
                                <TextBlock Grid.Column="1" Text="&#9656;" FontSize="11" Foreground="#FFB0B6C0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFF5F7FA" />
                                <Setter TargetName="AccentBar" Property="Background" Value="#FF1E88E5" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFF5F7FA" />
                                <Setter TargetName="AccentBar" Property="Background" Value="#FF1E88E5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- カテゴリのカード（見出し＋機能項目を常に表示） -->
        <Style x:Key="CategoryCardStyle" TargetType="Border">
            <Setter Property="Width" Value="220" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFE3E6EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

    </mah:MetroWindow.Resources>

    <Grid Margin="24" beh:EnterKeyNavigationBehavior.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <!--
            <TextBlock Text="石山商店" FontSize="12" Foreground="#FF8A93A3" />
            <TextBlock Text="販売管理システム" FontSize="24" FontWeight="Bold" Foreground="#FF1F2430" Margin="0,0,0,12" />
            -->
            <StackPanel Orientation="Horizontal">
            <Border Background="White" CornerRadius="8" Padding="14,8" BorderBrush="#FFE3E6EA" BorderThickness="1"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="15" Background="#FF1E88E5" Margin="0,0,10,0">
                        <TextBlock Text="{Binding EmployeeInitial}" Foreground="White" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding EmployeeName}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PermissionLevel, StringFormat=権限レベル {0}}" FontSize="11" Foreground="#FF8A93A3" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Button Content="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                    Command="{Binding OpenManualCommand}" ToolTip="操作マニュアルをブラウザで開きます"
                    AutomationProperties.Name="ヘルプ"
                    VerticalAlignment="Center" Margin="10,0,0,0" Width="36" Height="36" />
            </StackPanel>
        </StackPanel>

        <!-- メニュー本体: カテゴリのカードを横に並べ、幅に収まらなければ折り返す -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CategoryCardStyle}">
                            <StackPanel>
                                <Border Background="#FFE3F0FC" CornerRadius="7,7,0,0" Padding="14,8">
                                    <TextBlock Text="{Binding MenuName}" FontSize="14" FontWeight="Bold" Foreground="#FF1565C0" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding MenuName}"
                                                    Style="{StaticResource ListRowButtonStyle}"
                                                    Command="{Binding DataContext.OpenMenuItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding ScreenKey}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- フッター -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#FFD9822B" TextWrapping="Wrap" />
            <TextBlock Text="処理中..." Foreground="OrangeRed"
                       Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Text="{Binding ConnectionInfo}" FontSize="10" Foreground="#FFB0B6C0" Margin="0,4,0,0" />
            <TextBlock Text="{Binding BuildInfo}" FontSize="10" Foreground="#FFB0B6C0" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
