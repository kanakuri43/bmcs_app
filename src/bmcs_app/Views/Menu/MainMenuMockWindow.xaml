<mah:MetroWindow x:Class="bmcs_app.Views.Menu.MainMenuMockWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="BMCS_APP - メインメニュー（デザインモック）"
                 Height="820" Width="1240"
                 MinHeight="640" MinWidth="960"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False"
                 Background="#FFF3F5F8">
    <!--
        Phase 2-7 のデザイン検討用モック。メニュー構成マスタや権限判定とは連動しない
        静的な見た目確認専用の画面。3案をタブで切り替えて比較する。
        方向性が固まったら本実装（DB駆動）に置き換える。
    -->
    <mah:MetroWindow.Resources>

        <!-- ============ B案: タイル/カードグリッド型 ============ -->

        <Style x:Key="CategoryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,20,20" />
            <Setter Property="BorderBrush" Value="#FFE3E6EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="400" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF1B2A4A" Opacity="0.08" BlurRadius="16" ShadowDepth="2" Direction="270" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryAccentBarStyle" TargetType="Border">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="2.5" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="CategoryHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF2B2F36" />
        </Style>

        <Style x:Key="MenuTileButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="168" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#FF2B2F36" />
            <Setter Property="Background" Value="#FFF7F8FA" />
            <Setter Property="BorderBrush" Value="#FFE0E3E8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="Medium" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFECEEF1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ A案: サイドバー階層ツリー型 ============ -->

        <Style x:Key="TreeItemButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FF3A3F4B" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="34,0,8,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFEFF2F6" />
                                <Setter Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFEFF2F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ C案: リスト・アコーディオン型 ============ -->

        <Style x:Key="ListRowButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#FF2B2F36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="#FFE8EAED" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AccentBar" Grid.Column="0" Background="Transparent" />
                                <TextBlock Grid.Column="1" Text="&#9656;" FontSize="12" Foreground="#FFB0B6C0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFF5F7FA" />
                                <Setter TargetName="AccentBar" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFF5F7FA" />
                                <Setter TargetName="AccentBar" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- C案: カテゴリ見出しを折りたたむアコーディオン -->
        <Style x:Key="AccordionSectionStyle" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle"
                                          Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Cursor="Hand"
                                          HorizontalAlignment="Left"
                                          HorizontalContentAlignment="Left">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <StackPanel Margin="0,10,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Chevron"
                                                           Text="&#9656;"
                                                           FontSize="14"
                                                           Foreground="#FF8A93A3"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                                <TextBlock Text="{TemplateBinding Content}" FontSize="18" FontWeight="Bold" Foreground="#FF2B2F36" />
                                            </StackPanel>
                                            <Border Height="3" Width="40"
                                                    Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                    CornerRadius="1.5"
                                                    HorizontalAlignment="Left"
                                                    Margin="22,6,0,0" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chevron" Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="0,0,0,20" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </mah:MetroWindow.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダー（3案共通） -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="石山商店" FontSize="13" Foreground="#FF8A93A3" />
                <TextBlock Text="販売管理システム" FontSize="28" FontWeight="Bold" Foreground="#FF1F2430" />
                <TextBlock Text="デザイン比較モック（タブで3案を切り替え）" FontSize="12" Foreground="#FFB0B6C0" Margin="0,2,0,0" />
            </StackPanel>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="20"
                    Padding="16,8"
                    BorderBrush="#FFE3E6EA"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="16" Background="#FF1E88E5" Margin="0,0,10,0">
                        <TextBlock Text="山" Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="山田 太郎" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="権限レベル 3" FontSize="11" Foreground="#FF8A93A3" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- タブで3案を切り替え -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">

            <!-- ============ A案: サイドバー階層ツリー型 ============ -->
            <TabItem Header="A. サイドバー階層ツリー型" FontSize="14" Padding="16,8">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="10"
                            BorderBrush="#FFE3E6EA"
                            BorderThickness="1"
                            Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <Expander IsExpanded="True">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#FF1E88E5" Margin="0,0,8,0" />
                                            <TextBlock Text="受注・売上" FontWeight="SemiBold" FontSize="14" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,4,0,8">
                                        <Button Content="受注入力" Style="{StaticResource TreeItemButtonStyle}" Tag="#FF1E88E5" Click="MenuTile_Click" />
                                        <Button Content="売上入力" Style="{StaticResource TreeItemButtonStyle}" Tag="#FF1E88E5" Click="MenuTile_Click" />
                                    </StackPanel>
                                </Expander>

                                <Expander IsExpanded="True">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#FF00897B" Margin="0,0,8,0" />
                                            <TextBlock Text="請求" FontWeight="SemiBold" FontSize="14" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,4,0,8">
                                        <Button Content="請求締め" Style="{StaticResource TreeItemButtonStyle}" Tag="#FF00897B" Click="MenuTile_Click" />
                                        <Button Content="請求締め解除" Style="{StaticResource TreeItemButtonStyle}" Tag="#FF00897B" Click="MenuTile_Click" />
                                        <Button Content="明細請求書発行" Style="{StaticResource TreeItemButtonStyle}" Tag="#FF00897B" Click="MenuTile_Click" />
                                    </StackPanel>
                                </Expander>

                                <Expander>
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#FF43A047" Margin="0,0,8,0" />
                                            <TextBlock Text="入金" FontWeight="SemiBold" FontSize="14" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,4,0,8">
                                        <Button Content="入金入力（締め）" Style="{StaticResource TreeItemButtonStyle}" Tag="#FF43A047" Click="MenuTile_Click" />
                                        <Button Content="明細入金" Style="{StaticResource TreeItemButtonStyle}" Tag="#FF43A047" Click="MenuTile_Click" />
                                    </StackPanel>
                                </Expander>

                                <Expander>
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#FF7E57C2" Margin="0,0,8,0" />
                                            <TextBlock Text="元帳・照会" FontWeight="SemiBold" FontSize="14" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,4,0,8">
                                        <Button Content="得意先元帳" Style="{StaticResource TreeItemButtonStyle}" Tag="#FF7E57C2" Click="MenuTile_Click" />
                                        <Button Content="データ検索" Style="{StaticResource TreeItemButtonStyle}" Tag="#FF7E57C2" Click="MenuTile_Click" />
                                    </StackPanel>
                                </Expander>

                                <Expander>
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#FFFB8C00" Margin="0,0,8,0" />
                                            <TextBlock Text="月次締め" FontWeight="SemiBold" FontSize="14" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,4,0,8">
                                        <Button Content="月次締め" Style="{StaticResource TreeItemButtonStyle}" Tag="#FFFB8C00" Click="MenuTile_Click" />
                                        <Button Content="月次締め解除" Style="{StaticResource TreeItemButtonStyle}" Tag="#FFFB8C00" Click="MenuTile_Click" />
                                    </StackPanel>
                                </Expander>

                                <Expander>
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#FF607D8B" Margin="0,0,8,0" />
                                            <TextBlock Text="マスタ管理" FontWeight="SemiBold" FontSize="14" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,4,0,8">
                                        <Button Content="得意先マスタ" Style="{StaticResource TreeItemButtonStyle}" Tag="#FF607D8B" Click="MenuTile_Click" />
                                        <Button Content="商品マスタ" Style="{StaticResource TreeItemButtonStyle}" Tag="#FF607D8B" Click="MenuTile_Click" />
                                        <Button Content="社員マスタ" Style="{StaticResource TreeItemButtonStyle}" Tag="#FF607D8B" Click="MenuTile_Click" />
                                        <Button Content="自社情報マスタ" Style="{StaticResource TreeItemButtonStyle}" Tag="#FF607D8B" Click="MenuTile_Click" />
                                        <Button Content="銀行マスタ" Style="{StaticResource TreeItemButtonStyle}" Tag="#FF607D8B" Click="MenuTile_Click" />
                                        <Button Content="プリンタ設定" Style="{StaticResource TreeItemButtonStyle}" Tag="#FF607D8B" Click="MenuTile_Click" />
                                    </StackPanel>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2"
                            Background="White"
                            CornerRadius="10"
                            Padding="40"
                            BorderBrush="#FFE3E6EA"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="420">
                        <StackPanel>
                            <TextBlock Text="ようこそ、山田 太郎さん" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="左のメニューから機能を選択してください。" Foreground="#FF8A93A3" Margin="0,0,0,20" TextWrapping="Wrap" />
                            <Separator Margin="0,0,0,20" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="接続先" FontWeight="Bold" Margin="0,0,16,6" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="bmcs_db" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="権限レベル" FontWeight="Bold" Margin="0,0,16,6" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="3" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="日付" FontWeight="Bold" Margin="0,0,16,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="2026/09/10(木)" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ B案: タイル/カードグリッド型 ============ -->
            <TabItem Header="B. タイル/カードグリッド型" FontSize="14" Padding="16,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
                    <WrapPanel Orientation="Horizontal">

                        <Border Style="{StaticResource CategoryCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource CategoryAccentBarStyle}" Background="#FF1E88E5" />
                                    <TextBlock Text="受注・売上" Style="{StaticResource CategoryHeaderTextStyle}" />
                                </StackPanel>
                                <WrapPanel>
                                    <Button Content="受注入力" Style="{StaticResource MenuTileButtonStyle}" Tag="#FF1E88E5" Click="MenuTile_Click" />
                                    <Button Content="売上入力" Style="{StaticResource MenuTileButtonStyle}" Tag="#FF1E88E5" Click="MenuTile_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CategoryCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource CategoryAccentBarStyle}" Background="#FF00897B" />
                                    <TextBlock Text="請求" Style="{StaticResource CategoryHeaderTextStyle}" />
                                </StackPanel>
                                <WrapPanel>
                                    <Button Content="請求締め" Style="{StaticResource MenuTileButtonStyle}" Tag="#FF00897B" Click="MenuTile_Click" />
                                    <Button Content="請求締め解除" Style="{StaticResource MenuTileButtonStyle}" Tag="#FF00897B" Click="MenuTile_Click" />
                                    <Button Content="明細請求書発行" Style="{StaticResource MenuTileButtonStyle}" Tag="#FF00897B" Click="MenuTile_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CategoryCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource CategoryAccentBarStyle}" Background="#FF43A047" />
                                    <TextBlock Text="入金" Style="{StaticResource CategoryHeaderTextStyle}" />
                                </StackPanel>
                                <WrapPanel>
                                    <Button Content="入金入力（締め）" Style="{StaticResource MenuTileButtonStyle}" Tag="#FF43A047" Click="MenuTile_Click" />
                                    <Button Content="明細入金" Style="{StaticResource MenuTileButtonStyle}" Tag="#FF43A047" Click="MenuTile_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CategoryCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource CategoryAccentBarStyle}" Background="#FF7E57C2" />
                                    <TextBlock Text="元帳・照会" Style="{StaticResource CategoryHeaderTextStyle}" />
                                </StackPanel>
                                <WrapPanel>
                                    <Button Content="得意先元帳" Style="{StaticResource MenuTileButtonStyle}" Tag="#FF7E57C2" Click="MenuTile_Click" />
                                    <Button Content="データ検索" Style="{StaticResource MenuTileButtonStyle}" Tag="#FF7E57C2" Click="MenuTile_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CategoryCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource CategoryAccentBarStyle}" Background="#FFFB8C00" />
                                    <TextBlock Text="月次締め" Style="{StaticResource CategoryHeaderTextStyle}" />
                                </StackPanel>
                                <WrapPanel>
                                    <Button Content="月次締め" Style="{StaticResource MenuTileButtonStyle}" Tag="#FFFB8C00" Click="MenuTile_Click" />
                                    <Button Content="月次締め解除" Style="{StaticResource MenuTileButtonStyle}" Tag="#FFFB8C00" Click="MenuTile_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CategoryCardStyle}" Width="400">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource CategoryAccentBarStyle}" Background="#FF607D8B" />
                                    <TextBlock Text="マスタ管理" Style="{StaticResource CategoryHeaderTextStyle}" />
                                </StackPanel>
                                <WrapPanel>
                                    <Button Content="得意先マスタ" Style="{StaticResource MenuTileButtonStyle}" Tag="#FF607D8B" Click="MenuTile_Click" />
                                    <Button Content="商品マスタ" Style="{StaticResource MenuTileButtonStyle}" Tag="#FF607D8B" Click="MenuTile_Click" />
                                    <Button Content="社員マスタ" Style="{StaticResource MenuTileButtonStyle}" Tag="#FF607D8B" Click="MenuTile_Click" />
                                    <Button Content="自社情報マスタ" Style="{StaticResource MenuTileButtonStyle}" Tag="#FF607D8B" Click="MenuTile_Click" />
                                    <Button Content="銀行マスタ" Style="{StaticResource MenuTileButtonStyle}" Tag="#FF607D8B" Click="MenuTile_Click" />
                                    <Button Content="プリンタ設定" Style="{StaticResource MenuTileButtonStyle}" Tag="#FF607D8B" Click="MenuTile_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ C案: リスト・アコーディオン型 ============ -->
            <TabItem Header="C. リスト・アコーディオン型" FontSize="14" Padding="16,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
