<mah:MetroWindow x:Class="bmcs_app.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    Title="bmcs"
    Height="800" Width="200"
    ResizeMode="CanMinimize"
    WindowStartupLocation="CenterScreen"
    WindowTransitionsEnabled="False">

    <StackPanel Margin="16">

        <!-- 売上 -->
        <TextBlock Text="売上"
                   FontSize="12"
                   FontWeight="Bold"
                   Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                   Margin="0,0,0,4" />

        <Button Content="受注登録"
                Command="{Binding LaunchCommand}"
                CommandParameter="bmcs_app.Order.exe"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,4" />

        <Button Content="売上登録"
                Command="{Binding LaunchCommand}"
                CommandParameter="bmcs_app.Sales.exe"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,4" />
        
        <Button Content="入金登録"
                Command="{Binding LaunchCommand}"
                CommandParameter="bmcs_app.Receipt.exe"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,4" />

        <Button Content="伝票検索"
                Command="{Binding LaunchCommand}"
                CommandParameter="bmcs_app.Search.exe"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,16" />

        <!-- 仕入 -->
        <TextBlock Text="仕入"
                   FontSize="12"
                   FontWeight="Bold"
                   Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                   Margin="0,0,0,4" />

        <Button Content="発注登録"
                Command="{Binding LaunchCommand}"
                CommandParameter="bmcs_app.PurchaseOrder.exe"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,4" />

        <Button Content="仕入登録"
                Command="{Binding LaunchCommand}"
                CommandParameter="bmcs_app.Purchase.exe"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,4"/>

        <Button Content="支払登録"
                Command="{Binding LaunchCommand}"
                CommandParameter="bmcs_app.Payment.exe"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,4" />

        <Button Content="伝票検索"
                Command="{Binding LaunchCommand}"
                CommandParameter="bmcs_app.PurchaseSearch.exe"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,16" />

        <!-- 照会 -->
        <TextBlock Text="集計・照会"
                   FontSize="12"
                   FontWeight="Bold"
                   Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                   Margin="0,0,0,4" />

        <Button Content="請求管理"
                Command="{Binding LaunchCommand}"
                CommandParameter="bmcs_app.Closing.exe"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,4" />

        <Button Content="得意先元帳"
                IsEnabled="False"
                Command="{Binding LaunchCommand}"
                CommandParameter="bmcs_app.Search.exe"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,4" />

        <Button Content="仕入先元帳"
                IsEnabled="False"
                Command="{Binding LaunchCommand}"
                CommandParameter="bmcs_app.Search.exe"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,16" />

        <!-- マスタ保守 -->
        <TextBlock Text="マスタ保守"
                   FontSize="12"
                   FontWeight="Bold"
                   Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                   Margin="0,0,0,4" />

        <Button Content="社員マスタ"
                Command="{Binding LaunchCommand}"
                CommandParameter="bmcs_app.Master.exe"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,4" />

        <Button Content="得意先マスタ"
                Command="{Binding LaunchCommand}"
                CommandParameter="bmcs_app.Master.exe --master=customer"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,4" />

        <Button Content="仕入先マスタ"
                Command="{Binding LaunchCommand}"
                CommandParameter="bmcs_app.Master.exe --master=supplier"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,4" />

        <Button Content="商品マスタ"
                Command="{Binding LaunchCommand}"
                CommandParameter="bmcs_app.Master.exe --master=product"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,4" />

        <Button Content="消費税率"
                Command="{Binding LaunchCommand}"
                CommandParameter="bmcs_app.Master.exe --master=taxrate"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,16" />

        <!-- 設定 -->
        <TextBlock Text="設定"
                   FontSize="12"
                   FontWeight="Bold"
                   Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                   Margin="0,0,0,4" />

        <Button Content="プリンタ"
                Command="{Binding OpenPrinterSettingsCommand}"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,4" />

        <Button Content="自社情報"
                Command="{Binding OpenCompanyInfoSettingsCommand}"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,4" />

    </StackPanel>
</mah:MetroWindow>
