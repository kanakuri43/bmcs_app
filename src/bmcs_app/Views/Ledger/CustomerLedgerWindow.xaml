<mah:MetroWindow x:Class="bmcs_app.Views.Ledger.CustomerLedgerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                 Title="bmcs_app - 得意先元帳"
                 Height="760" Width="1600"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False">
    <!--
        得意先ごとの売上・入金明細と残高推移を時系列表示する。レイアウトは旧デモ
        （bmcs_app.CustomerLedger）を踏襲しつつ、部分消込・複数入金を扱うため入金額・残高の
        2列を追加した。都度得意先の消込済み売上行には、証跡として入金日付・入金No.を同じ行の
        右側に表示する（金額は載せない。残高は入金日付の独立行でのみ変化する）。
        締め得意先の入金は独立行になり、左側の売上欄は空欄になる。
        印刷・プレビューは帳票未実装のため枠のみ用意し無効化する。
        得意先・期間のいずれかを変更すると自動的に再表示するため、「表示」ボタンは撤去している。
        F5キーは他画面での更新後に手動で再表示したい場合に備えて残す。
    -->
    <mah:MetroWindow.InputBindings>
        <KeyBinding Key="F5" Command="{Binding SearchCommand}" />
    </mah:MetroWindow.InputBindings>

    <mah:MetroWindow.Resources>
        <!-- 行・数量・金額系の列はヘッダーも右詰めにする -->
        <Style x:Key="RightAlignedColumnHeaderStyle" TargetType="{x:Type GridViewColumnHeader}"
               BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </mah:MetroWindow.Resources>

    <Grid Margin="16" beh:ImeAwareSpaceKeyBindingBehavior.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- ヘッダー -->
            <RowDefinition Height="*" />    <!-- 明細 -->
            <RowDefinition Height="Auto" /> <!-- 合計 -->
            <RowDefinition Height="Auto" /> <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- ===== ヘッダー ===== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="得意先" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="CustomerCodeBox"
                         Width="120" Margin="0,0,4,0"
                         beh:FocusBehavior.IsInitialFocus="True"
                         Text="{Binding CustomerCode, UpdateSourceTrigger=PropertyChanged}"
                         mah:TextBoxHelper.Watermark="コード（SPACEで検索）">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Space" Command="{Binding OpenCustomerSearchCommand}" />
                        <KeyBinding Key="Return" Command="{Binding LookupCustomerByCodeCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="..." Width="28" Margin="0,0,12,0" Command="{Binding OpenCustomerSearchCommand}" />
                <TextBox Width="220" Margin="0,0,12,0"
                         Text="{Binding CustomerName, Mode=OneWay}"
                         IsReadOnly="True" IsTabStop="False"
                         Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                <TextBlock Text="{Binding TaxUnitDisplay}" VerticalAlignment="Center" Margin="0,0,24,0"
                           Foreground="{DynamicResource MahApps.Brushes.Gray3}" />

                <TextBlock Text="期間" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker Width="120" Margin="0,0,4,0"
                            SelectedDate="{Binding PeriodFrom}" />
                <TextBlock Text="〜" VerticalAlignment="Center" Margin="0,0,4,0" />
                <DatePicker Width="120" Margin="0,0,16,0"
                            SelectedDate="{Binding PeriodTo}" />

                <Button Content="プレビュー" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"
                        ToolTip="得意先元帳の印刷（未実装）" />
                <Button Content="印刷" Padding="12,6" IsEnabled="False"
                        ToolTip="得意先元帳の印刷（未実装）" />
            </StackPanel>

            <!-- 請求集約元の案内文（取引履歴のみモード）。 -->
            <TextBlock Text="{Binding AggregationNotice}" Margin="0,8,0,0" FontWeight="SemiBold"
                       Foreground="{DynamicResource MahApps.Brushes.Accent}"
                       Visibility="{Binding IsTransactionHistoryOnly, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!-- ===== 明細 ===== -->
        <!-- 行をEnter／ダブルクリックで活性化すると、対応する伝票を読み取り専用（プレビュー）で開く -->
        <ListView Grid.Row="1" ItemsSource="{Binding Lines}"
                  ToolTip="行をEnterまたはダブルクリックすると、対応する伝票をプレビュー表示します。"
                  beh:RowActivationBehavior.Command="{Binding OpenSlipPreviewCommand}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="区分" Width="60" DisplayMemberBinding="{Binding KindLabel}" />
                    <GridViewColumn Header="伝票日付" Width="90" DisplayMemberBinding="{Binding Entry.EntryDate, StringFormat={}{0:yyyy/MM/dd}}" />
                    <!-- 請求集約先の元帳はグループ内の複数得意先の伝票が混在するため、どの得意先の
                         伝票かを表示する。売上・入金行以外は空欄。 -->
                    <GridViewColumn Header="得意先" Width="140" DisplayMemberBinding="{Binding CustomerLabel}" />
                    <GridViewColumn Header="伝票No" Width="110" DisplayMemberBinding="{Binding Entry.SalesSlipNumber}" />
                    <GridViewColumn Header="行" Width="36" HeaderContainerStyle="{StaticResource RightAlignedColumnHeaderStyle}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Entry.SalesLineNumber}" HorizontalAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="商品コード" Width="80" DisplayMemberBinding="{Binding Entry.ProductCode}" />
                    <GridViewColumn Header="商品名／摘要" Width="160" DisplayMemberBinding="{Binding Description}" />
                    <GridViewColumn Header="課税区分" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Entry.TaxCategory, Converter={StaticResource EnumDisplayConverter}}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="数量" Width="70" HeaderContainerStyle="{StaticResource RightAlignedColumnHeaderStyle}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Entry.Quantity, StringFormat={}{0:N3}}" HorizontalAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="単価" Width="80" HeaderContainerStyle="{StaticResource RightAlignedColumnHeaderStyle}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Entry.UnitPrice, StringFormat={}{0:N0}}" HorizontalAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="売上額" Width="90" HeaderContainerStyle="{StaticResource RightAlignedColumnHeaderStyle}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Entry.DebitAmount, StringFormat={}{0:N0}}" HorizontalAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="請求" Width="36" DisplayMemberBinding="{Binding BilledMark}" />
                    <GridViewColumn Header="入金日付" Width="90" DisplayMemberBinding="{Binding Entry.ReceiptDate, StringFormat={}{0:yyyy/MM/dd}}" />
                    <GridViewColumn Header="入金No" Width="110" DisplayMemberBinding="{Binding Entry.ReceiptSlipNumber}" />
                    <GridViewColumn Header="入金額" Width="90" HeaderContainerStyle="{StaticResource RightAlignedColumnHeaderStyle}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Entry.ReceiptAmount, StringFormat={}{0:N0}}" HorizontalAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="残高" Width="100" HeaderContainerStyle="{StaticResource RightAlignedColumnHeaderStyle}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <!-- 取引履歴のみモード（請求集約元）は残高を表示しない
                                     （BalanceDisplayがnullを返し空欄になる）。 -->
                                <TextBlock Text="{Binding BalanceDisplay, StringFormat={}{0:N0}}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="備考" Width="200" DisplayMemberBinding="{Binding Entry.Remarks}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- ===== 合計 ===== -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,8"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- 前月繰越・消費税計・入金額計・残高は請求集約元（取引履歴のみモード）
                     では管理しないため非表示にする。売上額計は常に表示する（税抜）。 -->
                <!-- 現在残高。検索期間とは独立に、得意先確定時と表示(F5)実行時に
                     都度計算する（残高キャッシュ列は持たない）。 -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsBalanceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="現在残高" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="Bold" />
                    <TextBlock Text="{Binding CurrentBalance, StringFormat={}{0:N0}}" VerticalAlignment="Center"
                               Margin="0,0,32,0" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsBalanceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="前月繰越" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding OpeningBalance, StringFormat={}{0:N0}}" VerticalAlignment="Center" Margin="0,0,20,0" />
                </StackPanel>

                <TextBlock Text="売上額計" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="{Binding SalesTotal, StringFormat={}{0:N0}}" VerticalAlignment="Center" Margin="0,0,20,0" />

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsBalanceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="消費税計" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding TaxTotal, StringFormat={}{0:N0}}" VerticalAlignment="Center" Margin="0,0,20,0" />

                    <TextBlock Text="入金額計" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding ReceiptTotal, StringFormat={}{0:N0}}" VerticalAlignment="Center" Margin="0,0,20,0" />

                    <TextBlock Text="期間残高" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="Bold" FontSize="16" />
                    <TextBlock Text="{Binding ClosingBalance, StringFormat={}{0:N0}}" VerticalAlignment="Center"
                               FontWeight="Bold" FontSize="16" Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== StatusBar ===== -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="処理中..." Foreground="OrangeRed"
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</mah:MetroWindow>
