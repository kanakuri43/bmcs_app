<mah:MetroWindow x:Class="bmcs_app.Views.Sales.DeliveryNoteBulkIssueWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                 Title="bmcs_app - 納品書一括発行"
                 Height="640" Width="1000"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="伝票日付" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker SelectedDate="{Binding DateFrom}" Width="130" beh:FocusBehavior.IsInitialFocus="True" />
            <TextBlock Text="〜" VerticalAlignment="Center" Margin="8,0" />
            <DatePicker SelectedDate="{Binding DateTo}" Width="130" />
            <TextBlock Text="得意先" VerticalAlignment="Center" Margin="16,0,8,0" />
            <TextBox Width="120" Margin="0,0,4,0"
                     Text="{Binding CustomerCode, UpdateSourceTrigger=PropertyChanged}"
                     mah:TextBoxHelper.Watermark="コード（SPACEで検索）">
                <TextBox.InputBindings>
                    <KeyBinding Key="Space" Command="{Binding OpenCustomerSearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="..." Width="28" Margin="0,0,12,0" Command="{Binding OpenCustomerSearchCommand}" />
            <TextBox Width="220"
                     Text="{Binding CustomerName, Mode=OneWay}"
                     IsReadOnly="True" IsTabStop="False"
                     Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
            <Button Content="再読込" Command="{Binding ReloadCommand}" Padding="16,6" Margin="16,0,0,0" />
            <Button Content="全選択" Command="{Binding SelectAllCommand}" Padding="12,6" Margin="16,0,0,0" />
            <Button Content="全解除" Command="{Binding ClearAllCommand}" Padding="12,6" Margin="8,0,0,0" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" Margin="0,12,0,0"
                  AutoGenerateColumns="False" SelectionMode="Single"
                  HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="発行" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                <DataGridTextColumn Header="売上No." Binding="{Binding SalesSlipNumber}" IsReadOnly="True" Width="Auto" />
                <DataGridTextColumn Header="伝票日付" Binding="{Binding SlipDate, StringFormat={}{0:yyyy/MM/dd}}" IsReadOnly="True" Width="Auto" />
                <DataGridTextColumn Header="得意先コード" Binding="{Binding CustomerCode}" IsReadOnly="True" Width="Auto" />
                <DataGridTextColumn Header="得意先名" Binding="{Binding CustomerName}" IsReadOnly="True" Width="220" />
                <DataGridTextColumn Header="金額（税別）" Binding="{Binding TotalAmount, StringFormat={}{0:N0}}" IsReadOnly="True" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="結果" Binding="{Binding Result}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="処理中..." VerticalAlignment="Center" Foreground="OrangeRed"
                       Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Grid.Column="1" Content="一括発行" Command="{Binding IssueCommand}" Padding="16,6" />
        </Grid>

        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</mah:MetroWindow>
