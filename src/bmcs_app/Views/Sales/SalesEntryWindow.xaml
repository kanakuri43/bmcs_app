<mah:MetroWindow x:Class="bmcs_app.Views.Sales.SalesEntryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                 xmlns:common="clr-namespace:bmcs_app.Views.Common"
                 Title="{Binding WindowTitle}"
                 Height="720" Width="1100"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False">
    <!--
        TODO.md 5-2〜5-6。旧プロトタイプ（bmcs_app.Sales の SalesMainView.xaml）のレイアウトを
        再現しつつ、都度売上の直接入力・受注からの売上確定・返品値引・過去伝票の複写・
        既存伝票の訂正取消を扱う。印刷・前後移動・担当者は、対象フェーズが別、またはこの
        プロジェクトのスキーマ／機能にまだ存在しないため、枠のみ用意し無効化している
        （理由は docs/design_document.md）。
    -->
    <mah:MetroWindow.InputBindings>
        <KeyBinding Key="F2"  Command="{Binding AddLineCommand}" />
        <KeyBinding Key="F3"  Command="{Binding NewCommand}" />
        <KeyBinding Key="F8"  Command="{Binding DeleteSlipCommand}" />
        <KeyBinding Key="F10" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F11" Command="{Binding PrintCommand}" />
    </mah:MetroWindow.InputBindings>

    <Grid beh:EnterKeyNavigationBehavior.IsEnabled="True"
          beh:ImeAwareSpaceKeyBindingBehavior.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- ToolBar -->
            <RowDefinition Height="Auto" />  <!-- ヘッダー -->
            <RowDefinition Height="*"    />  <!-- 明細 -->
            <RowDefinition Height="Auto" />  <!-- フッター集計 -->
            <RowDefinition Height="Auto" />  <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- ===== ToolBar ===== -->
        <ToolBar Grid.Row="0" ToolBarTray.IsLocked="True">
            <Button Command="{Binding NewCommand}"
                    Content="新規 (F3)"
                    ToolTip="新規売上を作成します (F3)" />
            <Separator />
            <Button Command="{Binding PrevSlipCommand}"
                    Content="|◀"
                    ToolTip="前の売上（未実装）"
                    Style="{DynamicResource MahApps.Styles.Button.Flat}" />
            <Button Command="{Binding NextSlipCommand}"
                    Content="▶|"
                    ToolTip="次の売上（未実装）"
                    Style="{DynamicResource MahApps.Styles.Button.Flat}" />
            <Separator />
            <Button Command="{Binding CopyFromPastSlipCommand}"
                    Content="複写"
                    ToolTip="過去の売上伝票を複写して新規登録します（TODO.md 5-5）" />
            <Separator />
        </ToolBar>

        <!-- ===== 伝票ヘッダー ===== -->
        <Border Grid.Row="1"
                Padding="12,8"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource MahApps.Brushes.Gray10}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>

                <!-- 請求状態・消込状態（新規登録時は未請求・未消込固定。既存伝票読込時は実際の状態を表示） -->
                <Border Grid.Column="1"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="10,8"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*"  />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4"    />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="請求状態："
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding BillingStatusDisplay}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="消込状態："
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding SettlementStatusDisplay}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="0">
                    <!-- 行1: 売上No. / 売上日付 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"  />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="16"  />
                            <ColumnDefinition Width="58"  />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*"   />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="売上No." VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 beh:FocusBehavior.IsInitialFocus="True"
                                 IsReadOnly="{Binding IsHeaderLocked}"
                                 Text="{Binding SalesSlipNumberDisplay, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="自動採番（SPACEで検索）"
                                 ToolTip="既存の売上No.を入力してEnterで読み込む（訂正・取消。TODO.md 5-6）。Spaceで検索モーダルを開く">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Space"  Command="{Binding OpenSalesSlipSearchCommand}" />
                                <KeyBinding Key="Return" Command="{Binding LookupSalesSlipByNumberCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <TextBlock Grid.Column="3" Text="売上日付" VerticalAlignment="Center" />
                        <DatePicker Grid.Column="4"
                                    beh:FocusBehavior.FocusKey="SlipDate"
                                    mah:ControlsHelper.IsReadOnly="{Binding IsHeaderLocked}"
                                    SelectedDate="{Binding SlipDate}" />
                    </Grid>

                    <!-- 行2: 受注No.（TODO.md 5-3。受注からの売上確定） -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"  />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*"   />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="受注No." VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 IsReadOnly="{Binding IsHeaderLocked}"
                                 Text="{Binding OrderSlipNumberQuery, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="任意（SPACEで検索）"
                                 ToolTip="受注No.を入力してEnterで残数量を明細行へ転記する。Spaceで受注検索モーダルを開く">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Space"  Command="{Binding OpenOrderSlipSearchCommand}" />
                                <KeyBinding Key="Return" Command="{Binding LookupOrderSlipByNumberCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>

                    <!-- 行3: 得意先 -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"  />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="8"   />
                            <ColumnDefinition Width="*"   />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="得意先" VerticalAlignment="Center" />
                        <TextBox x:Name="CustomerCodeBox"
                                 Grid.Column="1"
                                 beh:FocusBehavior.FocusKey="CustomerCode"
                                 IsReadOnly="{Binding IsHeaderLocked}"
                                 Text="{Binding CustomerCode, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="コード（SPACEで検索）">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Space"  Command="{Binding OpenCustomerSearchCommand}" />
                                <KeyBinding Key="Return" Command="{Binding LookupCustomerByCodeCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBox Grid.Column="3"
                                 IsReadOnly="{Binding IsHeaderLocked}"
                                 Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="名称（宛名変更時は上書き可）"
                                 ToolTip="得意先コード検索後に自動入力される名称。学校のクラス・先生等の宛名を都度変更する場合は、ここを直接書き換える（子得意先マスタは持たない。C-9・2026-09-10確定）" />
                    </Grid>

                    <!-- 行4: 担当者（枠のみ・使用不可。sales に担当者列がなく、社員マスタ画面も未着手） -->
                    <Grid Margin="0,6,0,0" IsEnabled="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"  />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="8"   />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*"   />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="担当者" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding EmployeeCode}"
                                 mah:TextBoxHelper.Watermark="（未実装）" />
                        <TextBox Grid.Column="3"
                                 Text="{Binding EmployeeName, Mode=OneWay}"
                                 IsReadOnly="True"
                                 IsTabStop="False"
                                 Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    </Grid>

                    <!-- 行5: 摘要（伝票摘要。保存時に明細の全行へ複写する） -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*"  />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="摘要" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 IsReadOnly="{Binding IsHeaderLocked}"
                                 Text="{Binding SlipRemarks}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 明細 ===== -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"    />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 列ヘッダー（SlipLineControl の列幅と一致させる） -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                    BorderThickness="0,1,0,1"
                    Background="{DynamicResource MahApps.Brushes.Gray10}"
                    Padding="0,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"  />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*"   />
                        <ColumnDefinition Width="68"  />
                        <ColumnDefinition Width="72"  />
                        <ColumnDefinition Width="88"  />
                        <ColumnDefinition Width="80"  />
                        <ColumnDefinition Width="96"  />
                        <ColumnDefinition Width="56"  />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="28"  />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text=""       HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Grid.Column="1" Text="商品コード" Padding="2,0" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Grid.Column="2" Text="商品名"    Padding="2,0" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Grid.Column="3" Text="区分"      Padding="2,0" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Grid.Column="4" Text="数量"      HorizontalAlignment="Right" Padding="2,0" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Grid.Column="5" Text="単価"      HorizontalAlignment="Right" Padding="2,0" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Grid.Column="6" Text="原価"      HorizontalAlignment="Right" Padding="2,0" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Grid.Column="7" Text="金額"      HorizontalAlignment="Right" Padding="2,0" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Grid.Column="8" Text="税率"      HorizontalAlignment="Right" Padding="2,0" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Grid.Column="9" Text="行摘要" Padding="2,0" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                </Grid>
            </Border>

            <!-- 明細行リスト -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Lines}"
                              IsEnabled="{Binding IsEditable}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <common:SlipLineControl />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 行追加ボタン -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="4,2,4,4">
                <Button Command="{Binding AddLineCommand}"
                        Content="行追加 (F2)"
                        ToolTip="明細行を追加します (F2)"
                        Padding="8,2" />
            </StackPanel>
        </Grid>

        <!-- ===== フッター: 集計 + 操作ボタン ===== -->
        <Border Grid.Row="3"
                Padding="12,8"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*"    />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 税抜金額 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="《税抜金額》"
                               FontSize="11"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                               Margin="0,0,0,2" />
                    <TextBox Text="{Binding TaxExcludedTotal, StringFormat={}{0:N0}, Mode=OneWay}"
                             IsReadOnly="True"
                             TextAlignment="Right"
                             FontWeight="Bold"
                             FontSize="14"
                             Width="120" />
                </StackPanel>

                <!-- 粗利 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="《粗利》"
                               FontSize="11"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                               Margin="0,0,0,2" />
                    <TextBox Text="{Binding GrossProfit, StringFormat={}{0:N0}, Mode=OneWay}"
                             IsReadOnly="True"
                             TextAlignment="Right"
                             FontWeight="Bold"
                             FontSize="14"
                             Width="120" />
                </StackPanel>

                <!-- 消費税計 -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="《消費税計》"
                               FontSize="11"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                               Margin="0,0,0,2" />
                    <TextBox Text="{Binding TaxTotal, StringFormat={}{0:N0}, Mode=OneWay}"
                             IsReadOnly="True"
                             TextAlignment="Right"
                             FontWeight="Bold"
                             FontSize="14"
                             Width="120" />
                </StackPanel>

                <!-- 合計ブロック (外税/合計) -->
                <Border Grid.Column="4"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                        BorderThickness="1"
                        Padding="8,4"
                        Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"  />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4"    />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="（外税）"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding ExternalTaxTotal, StringFormat={}{0:N0}, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextAlignment="Right" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="合計"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontWeight="Bold" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding GrandTotal, StringFormat={}{0:N0}, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextAlignment="Right"
                                 FontWeight="Bold"
                                 FontSize="14"
                                 Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                    </Grid>
                </Border>

                <!-- 操作ボタン（縦並び: 保存 / 印刷 / 削除） -->
                <StackPanel Grid.Column="5"
                            Orientation="Vertical"
                            VerticalAlignment="Center"
                            Width="110">
                    <Button Command="{Binding SaveCommand}"
                            Content="保存 (F10)"
                            ToolTip="売上を保存します (F10)"
                            Margin="0,0,0,4"
                            Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" />
                    <Button Command="{Binding PrintCommand}"
                            Content="印刷 (F11)"
                            ToolTip="納品書を発行します（既存伝票を読み込んでいる場合のみ。新規登録直後は保存時に確認します）"
                            Margin="0,0,0,4" />
                    <Button Command="{Binding DeleteSlipCommand}"
                            Content="削除 (F8)"
                            ToolTip="読み込んだ売上を取消します（編集ロック中は無効。TODO.md 5-6）" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== StatusBar ===== -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</mah:MetroWindow>
