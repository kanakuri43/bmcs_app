<mah:MetroWindow x:Class="bmcs_app.Views.Sales.CopierSalesImportWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                 Title="bmcs_app - コピー機売上CSV取込"
                 Height="640" Width="1320"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False"
                 AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="ファイル選択" Command="{Binding SelectFileCommand}"
                    beh:FocusBehavior.IsInitialFocus="True" Padding="16,6" Margin="0,0,12,0" />
            <TextBlock Text="{Binding FilePath}" VerticalAlignment="Center" Foreground="Gray" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding ProductError}" Foreground="OrangeRed" FontWeight="Bold" Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ProductError}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 得意先元帳と同じ ListView／GridView。1行おきに薄いグレー（選択・ホバー中は既存のハイライトを優先）。 -->
        <ListView Grid.Row="2" ItemsSource="{Binding Rows}" Margin="0,12,0,0"
                  SelectionMode="Single" AlternationCount="2">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <Style.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ItemsControl.AlternationIndex" Value="1" />
                                <Condition Property="IsSelected" Value="False" />
                                <Condition Property="IsMouseOver" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="#F2F2F2" />
                        </MultiTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="行" Width="40" DisplayMemberBinding="{Binding LineNumber}" />
                    <GridViewColumn Header="機番" Width="90" DisplayMemberBinding="{Binding MachineNo}" />
                    <GridViewColumn Header="得意先コード" Width="100" DisplayMemberBinding="{Binding CustomerCode}" />
                    <GridViewColumn Header="得意先名" Width="160" DisplayMemberBinding="{Binding CustomerName}" />
                    <GridViewColumn Header="締日" Width="90" DisplayMemberBinding="{Binding ClosingDate, StringFormat={}{0:yyyy/MM/dd}}" />
                    <GridViewColumn Header="機種名" Width="140" DisplayMemberBinding="{Binding ModelName}" />
                    <GridViewColumn Header="金額（税別）" Width="100" HeaderContainerStyle="{StaticResource RightAlignedColumnHeaderStyle}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Amount, StringFormat={}{0:N0}}" HorizontalAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="合算行数" Width="70" DisplayMemberBinding="{Binding MergedLineCount}" />
                    <GridViewColumn Header="状態" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StateText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Importable">
                                                    <Setter Property="Foreground" Value="SeaGreen" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Succeeded">
                                                    <Setter Property="Foreground" Value="SeaGreen" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Imported">
                                                    <Setter Property="Foreground" Value="Gray" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Excluded">
                                                    <Setter Property="Foreground" Value="DarkGoldenrod" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Error">
                                                    <Setter Property="Foreground" Value="Crimson" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                    <Setter Property="Foreground" Value="Crimson" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="理由・結果" Width="420" DisplayMemberBinding="{Binding Reason}" />
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="2" Margin="0,12,0,0" BorderBrush="Gray" BorderThickness="2" CornerRadius="8"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource MahApps.Colors.ThemeBackground}" />
            </Border.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="64" Foreground="Gray"
                           HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock Text="ここにCSVファイルをドラッグ＆ドロップ&#10;（または「ファイル選択」ボタン）"
                           FontSize="20" Foreground="Gray" TextAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBlock Text="処理中..." VerticalAlignment="Center" Margin="16,0,0,0" Foreground="OrangeRed"
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <Button Grid.Column="1" Content="取込実行" Command="{Binding ImportCommand}" Padding="16,6" />
        </Grid>

        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</mah:MetroWindow>
