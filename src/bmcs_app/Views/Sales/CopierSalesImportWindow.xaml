<mah:MetroWindow x:Class="bmcs_app.Views.Sales.CopierSalesImportWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                 Title="bmcs_app - コピー機売上CSV取込"
                 Height="640" Width="1100"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="ファイル選択" Command="{Binding SelectFileCommand}"
                    beh:FocusBehavior.IsInitialFocus="True" Padding="16,6" Margin="0,0,12,0" />
            <TextBlock Text="{Binding FilePath}" VerticalAlignment="Center" Foreground="Gray" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding ProductError}" Foreground="OrangeRed" FontWeight="Bold" Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ProductError}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" Margin="0,12,0,0"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="行" Binding="{Binding LineNumber}" Width="Auto" />
                <DataGridTextColumn Header="機番" Binding="{Binding MachineNo}" Width="Auto" />
                <DataGridTextColumn Header="得意先コード" Binding="{Binding CustomerCode}" Width="Auto" />
                <DataGridTextColumn Header="得意先名" Binding="{Binding CustomerName}" Width="160" />
                <DataGridTextColumn Header="締日" Binding="{Binding ClosingDate, StringFormat={}{0:yyyy/MM/dd}}" Width="Auto" />
                <DataGridTextColumn Header="機種名" Binding="{Binding ModelName}" Width="140" />
                <DataGridTextColumn Header="金額（税別）" Binding="{Binding Amount, StringFormat={}{0:N0}}" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="合算行数" Binding="{Binding MergedLineCount}" Width="Auto" />
                <DataGridTextColumn Header="状態" Binding="{Binding StateText}" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Importable">
                                    <Setter Property="Foreground" Value="SeaGreen" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Succeeded">
                                    <Setter Property="Foreground" Value="SeaGreen" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Imported">
                                    <Setter Property="Foreground" Value="Gray" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Excluded">
                                    <Setter Property="Foreground" Value="DarkGoldenrod" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Error">
                                    <Setter Property="Foreground" Value="Crimson" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                    <Setter Property="Foreground" Value="Crimson" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="理由・結果" Binding="{Binding Reason}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBlock Text="処理中..." VerticalAlignment="Center" Margin="16,0,0,0" Foreground="OrangeRed"
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <Button Grid.Column="1" Content="取込実行" Command="{Binding ImportCommand}" Padding="16,6" />
        </Grid>

        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</mah:MetroWindow>
