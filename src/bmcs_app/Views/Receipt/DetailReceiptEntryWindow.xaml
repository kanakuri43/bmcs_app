<mah:MetroWindow x:Class="bmcs_app.Views.Receipt.DetailReceiptEntryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                 xmlns:local="clr-namespace:bmcs_app.Views.Receipt"
                 Title="{Binding WindowTitle}"
                 Height="760" Width="1180"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False">
    <!--
        TODO.md 7-4・7-5。都度得意先（内税明細単位）専用。画面レイアウトは旧デモ bmcs_app.LineReceipt を
        踏襲（左＝入金登録の明細行、右＝上段タブ〈売上伝票／明細請求書〉＋下段の選択伝票明細）。
        充当の粒度はスキーマに合わせ、売上伝票タブ＝売上明細行単位、明細請求書タブ＝請求書まるごと
        1行とした（デモは請求書タブでも行単位だったが不採用。docs/design_document.md 18章）。
        金額は常に対象の全額（または残額）で固定・読み取り専用。
        既存伝票の訂正・取消（7-5）は伝票No.欄で読み込んだ後、入金方法・入金先口座・行摘要・行の削除・
        伝票摘要・入金日付の変更のみ保存(F10)＝訂正として扱う。充当先の追加はできないため、読込後は
        右ペインの候補一覧が空になる（AddLineCommandは新規登録時のみ実行可）。取消(F8)＝取消。
        振込手数料差額の入力（7-3）は範囲外。
    -->
    <mah:MetroWindow.InputBindings>
        <KeyBinding Key="F2"  Command="{Binding AddLineCommand}" CommandParameter="{Binding SelectedPayableCandidate}" />
        <KeyBinding Key="F3"  Command="{Binding NewCommand}" />
        <KeyBinding Key="F8"  Command="{Binding DeleteSlipCommand}" />
        <KeyBinding Key="F10" Command="{Binding SaveCommand}" />
    </mah:MetroWindow.InputBindings>

    <Grid beh:EnterKeyNavigationBehavior.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- ToolBar -->
            <RowDefinition Height="Auto" /> <!-- ヘッダー -->
            <RowDefinition Height="*" />    <!-- 入金登録 / 候補（2ペイン） -->
            <RowDefinition Height="Auto" /> <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- ===== ToolBar ===== -->
        <ToolBar Grid.Row="0" ToolBarTray.IsLocked="True">
            <Button Command="{Binding NewCommand}"
                    Content="新規 (F3)"
                    ToolTip="新規明細入金を作成します (F3)" />
            <Separator />
            <Button Command="{Binding DeleteSlipCommand}"
                    Content="取消 (F8)"
                    ToolTip="読み込んだ明細入金を取消します (F8)。TODO.md 7-5" />
        </ToolBar>

        <!-- ===== ヘッダー ===== -->
        <Border Grid.Row="1"
                Padding="12,8"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource MahApps.Brushes.Gray10}">
            <StackPanel>

                <!-- 行1: 入金No. / 入金日付 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="入金No." VerticalAlignment="Center" />
                    <TextBox x:Name="DetailReceiptNumberBox"
                             Grid.Column="1"
                             beh:FocusBehavior.IsInitialFocus="True"
                             IsReadOnly="{Binding IsPreviewMode}"
                             Text="{Binding DetailReceiptNumberQuery, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="自動採番（Space検索、既存分はEnterで読込）"
                             mah:TextBoxHelper.ClearTextButton="True"
                             MaxLength="20"
                             HorizontalAlignment="Left"
                             Width="240"
                             ToolTip="既存の明細入金No.を入力してEnterで読み込む（訂正・取消モード）。Spaceで検索モーダルを開く">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Space"  Command="{Binding OpenDetailReceiptSearchCommand}" />
                            <KeyBinding Key="Return" Command="{Binding LookupCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <TextBlock Grid.Column="3" Text="入金日付" VerticalAlignment="Center" />
                    <TextBox Grid.Column="4"
                             Style="{StaticResource DateTextBoxStyle}"
                             IsReadOnly="{Binding IsHeaderLocked}"
                             beh:FocusBehavior.FocusKey="ReceiptDate"
                             Text="{Binding ReceiptDateText, UpdateSourceTrigger=LostFocus}" />
                </Grid>

                <!-- 行2: 得意先 -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="得意先" VerticalAlignment="Center" />
                    <TextBox x:Name="CustomerCodeBox"
                             Grid.Column="1"
                             IsReadOnly="{Binding IsExistingLoaded}"
                             Text="{Binding CustomerCode, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="コード（Space検索）">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Space"  Command="{Binding OpenCustomerSearchCommand}" />
                            <KeyBinding Key="Return" Command="{Binding LookupCustomerByCodeCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBox Grid.Column="3"
                             Text="{Binding CustomerName, Mode=OneWay}"
                             IsReadOnly="True"
                             IsTabStop="False"
                             Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                </Grid>

                <!-- 行3: 摘要 -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="摘要" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             IsReadOnly="{Binding IsHeaderLocked}"
                             Text="{Binding SlipRemarks, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="（任意）"
                             MaxLength="200" />
                </Grid>

            </StackPanel>
        </Border>

        <!-- ===== 入金登録 / 売上伝票・明細請求書候補（2ペイン） ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="480" />
                <ColumnDefinition Width="5"    />
                <ColumnDefinition Width="*"    MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- 左: 入金登録 -->
            <Grid Grid.Column="0" Margin="8,8,4,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"    />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="入金登録" FontWeight="Bold" Margin="0,0,0,4" />

                <!-- 列ヘッダー（DetailReceiptLineControl の列幅と一致させる） -->
                <Border Grid.Row="1" BorderThickness="0,1,0,1" Padding="0,3"
                        Background="{DynamicResource MahApps.Brushes.Gray10}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"  />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="90"  />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="90"  />
                            <ColumnDefinition Width="*"   />
                            <ColumnDefinition Width="28"  />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="充当先" Padding="2,0" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="入金方法" Padding="2,0" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="入金先口座" Padding="2,0" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="金額" Padding="2,0" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="行摘要" Padding="2,0" FontSize="11" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <!-- 明細行リスト -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Lines}"
                                  IsEnabled="{Binding IsEditable}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:DetailReceiptLineControl />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- フッター: 合計 + 保存ボタン -->
                <Grid Grid.Row="4" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"    />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="《今回入金額》" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                        <TextBlock Text="{Binding ReceiptTotal, StringFormat={}{0:N0}}"
                                   HorizontalAlignment="Right" FontWeight="Bold" FontSize="16"
                                   Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="保存 (F10)"
                            Command="{Binding SaveCommand}"
                            ToolTip="明細入金を保存します (F10)"
                            Padding="16,6"
                            Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" />
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource MahApps.Brushes.Gray8}" />

            <!-- 右: 売上伝票 / 明細請求書候補（上下2ペイン）。プレビュー中は充当先の選択に意味が無いため無効化する（TODO.md 8-3） -->
            <Grid Grid.Column="2" Margin="4,8,8,8" IsEnabled="{Binding IsEditable}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.3*" />
                    <RowDefinition Height="5"    />
                    <RowDefinition Height="1*"   />
                </Grid.RowDefinitions>

                <!-- 上: 売上伝票リスト / 明細請求書リスト（タブ切替） -->
                <TabControl Grid.Row="0" SelectedIndex="{Binding RightTabIndex, Mode=TwoWay}">

                    <!-- タブ: 売上伝票 -->
                    <TabItem Header="売上伝票">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*"    />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Margin="0,0,0,4" Text="売上伝票リスト（未消込・一部消込）" FontWeight="Bold" />

                            <ListView Grid.Row="1"
                                      ItemsSource="{Binding CandidateSlips}"
                                      SelectedItem="{Binding SelectedCandidateSlip, Mode=TwoWay}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="伝票No." Width="110" DisplayMemberBinding="{Binding SalesSlipNumber}" />
                                        <GridViewColumn Header="売上日" Width="85" DisplayMemberBinding="{Binding SlipDate, StringFormat={}{0:yyyy/MM/dd}}" />
                                        <GridViewColumn Header="件数" Width="55" DisplayMemberBinding="{Binding LineCount}" />
                                        <GridViewColumn Header="残額" Width="90" DisplayMemberBinding="{Binding TotalAmount, StringFormat={}{0:N0}}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </TabItem>

                    <!-- タブ: 明細請求書 -->
                    <TabItem Header="明細請求書">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*"    />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Margin="0,0,0,4" Text="明細請求書リスト（発行済・未入金）" FontWeight="Bold" />

                            <ListView Grid.Row="1"
                                      ItemsSource="{Binding InvoiceCandidates}"
                                      SelectedItem="{Binding SelectedInvoiceCandidate, Mode=TwoWay}"
                                      beh:RowActivationBehavior.Command="{Binding AddLineCommand}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="請求書No." Width="110" DisplayMemberBinding="{Binding DetailInvoiceNumber}" />
                                        <GridViewColumn Header="請求日" Width="85" DisplayMemberBinding="{Binding IssueDate, StringFormat={}{0:yyyy/MM/dd}}" />
                                        <GridViewColumn Header="宛名" Width="140" DisplayMemberBinding="{Binding AddresseeName}" />
                                        <GridViewColumn Header="件数" Width="50" DisplayMemberBinding="{Binding LineCount}" />
                                        <GridViewColumn Header="金額" Width="90" DisplayMemberBinding="{Binding TotalAmount, StringFormat={}{0:N0}}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="選択した請求書を追加 ▶"
                                        Command="{Binding AddLineCommand}"
                                        CommandParameter="{Binding SelectedInvoiceCandidate}"
                                        Padding="8,4"
                                        ToolTip="請求書まるごと1行として取り込みます（金額は請求書合計額で固定）" />
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>

                <GridSplitter Grid.Row="1"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource MahApps.Brushes.Gray8}" />

                <!-- 下: 選択伝票の明細 -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*"    />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,4,0,4" Text="明細リスト" FontWeight="Bold" />

                    <!-- 売上伝票タブの明細（行単位で取込可） -->
                    <ListView Grid.Row="1"
                              Visibility="{Binding IsSlipTabActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                              ItemsSource="{Binding SelectedSlipLines}"
                              SelectedItem="{Binding SelectedSlipLine, Mode=TwoWay}"
                              beh:RowActivationBehavior.Command="{Binding AddLineCommand}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="商品コード" Width="90" DisplayMemberBinding="{Binding ProductCode}" />
                                <GridViewColumn Header="商品名" Width="140" DisplayMemberBinding="{Binding ProductName}" />
                                <GridViewColumn Header="数量" Width="55" DisplayMemberBinding="{Binding Quantity, StringFormat={}{0:N0}}" />
                                <GridViewColumn Header="単価" Width="70" DisplayMemberBinding="{Binding UnitPrice, StringFormat={}{0:N0}}" />
                                <GridViewColumn Header="残額" Width="90" DisplayMemberBinding="{Binding RemainingAmount, StringFormat={}{0:N0}}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- 明細請求書タブの明細（参考表示・読み取り専用。行単位では取込めない） -->
                    <ListView Grid.Row="1"
                              Visibility="{Binding IsInvoiceTabActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                              ItemsSource="{Binding SelectedInvoiceLines}"
                              IsHitTestVisible="False">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="商品コード" Width="90" DisplayMemberBinding="{Binding ProductCode}" />
                                <GridViewColumn Header="商品名" Width="140" DisplayMemberBinding="{Binding ProductName}" />
                                <GridViewColumn Header="数量" Width="55" DisplayMemberBinding="{Binding Quantity, StringFormat={}{0:N0}}" />
                                <GridViewColumn Header="単価" Width="70" DisplayMemberBinding="{Binding UnitPrice, StringFormat={}{0:N0}}" />
                                <GridViewColumn Header="金額（税込）" Width="95" DisplayMemberBinding="{Binding Amount, StringFormat={}{0:N0}}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock Grid.Row="2"
                               Visibility="{Binding IsInvoiceTabActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                               Text="参考表示（読み取り専用）。取込は上のリストから請求書単位で行います。" />
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== StatusBar ===== -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="処理中..." Foreground="OrangeRed"
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</mah:MetroWindow>
