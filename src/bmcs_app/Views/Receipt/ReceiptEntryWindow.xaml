<mah:MetroWindow x:Class="bmcs_app.Views.Receipt.ReceiptEntryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                 xmlns:local="clr-namespace:bmcs_app.Views.Receipt"
                 Title="bmcs_app - 入金入力"
                 Height="680" Width="900"
                 WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False">
    <!--
        TODO.md 7-2。締め得意先（請求単位／伝票単位）専用。明細行は支払手段の内訳（入金方法＋金額）
        であり、利用者が直接追加・編集・削除する（売上入力と同じ明細行パターン。
        docs/design_document.md 17章、2026-09-15改訂）。請求への充当は保存時に内部で自動計算し、
        画面には表示しない（利用者に必要なのは充当先ではなく残高のため、請求残高を表示する）。
        振込手数料差額の入力（7-3）・既存伝票の訂正／取消（7-5）は範囲外のため、取消(F8)は
        枠のみ用意し無効化する。
    -->
    <mah:MetroWindow.InputBindings>
        <KeyBinding Key="F2"  Command="{Binding AddLineCommand}" />
        <KeyBinding Key="F3"  Command="{Binding NewCommand}" />
        <KeyBinding Key="F10" Command="{Binding SaveCommand}" />
    </mah:MetroWindow.InputBindings>

    <Grid beh:EnterKeyNavigationBehavior.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- ToolBar -->
            <RowDefinition Height="Auto" /> <!-- ヘッダー -->
            <RowDefinition Height="*" />    <!-- 明細（支払手段の内訳） -->
            <RowDefinition Height="Auto" /> <!-- フッター -->
            <RowDefinition Height="Auto" /> <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- ===== ToolBar ===== -->
        <ToolBar Grid.Row="0" ToolBarTray.IsLocked="True">
            <Button Command="{Binding NewCommand}"
                    Content="新規 (F3)"
                    ToolTip="新規入金を作成します (F3)" />
            <Separator />
            <Button Command="{Binding DeleteSlipCommand}"
                    Content="取消 (F8)"
                    IsEnabled="False"
                    ToolTip="入金の取消・訂正（TODO.md 7-5、未実装）" />
        </ToolBar>

        <!-- ===== ヘッダー ===== -->
        <Border Grid.Row="1"
                Padding="12,8"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource MahApps.Brushes.Gray10}">
            <StackPanel>

                <!-- 行1: 入金No. / 入金日付 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="入金No." VerticalAlignment="Center" />
                    <TextBox x:Name="ReceiptSlipNumberBox"
                             Grid.Column="1"
                             beh:FocusBehavior.IsInitialFocus="True"
                             Text="{Binding ReceiptSlipNumberQuery, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="自動採番（Space検索、既存分はEnterで読込）"
                             mah:TextBoxHelper.ClearTextButton="True"
                             MaxLength="20"
                             HorizontalAlignment="Left"
                             Width="240"
                             ToolTip="既存の入金No.を入力してEnterで読み込む（読み取り専用表示）。Spaceで検索モーダルを開く">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Space"  Command="{Binding OpenReceiptSlipSearchCommand}" />
                            <KeyBinding Key="Return" Command="{Binding LookupCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <TextBlock Grid.Column="3" Text="入金日付" VerticalAlignment="Center" />
                    <TextBox Grid.Column="4"
                             Style="{StaticResource DateTextBoxStyle}"
                             IsReadOnly="{Binding IsExistingLoaded}"
                             beh:FocusBehavior.FocusKey="ReceiptDate"
                             Text="{Binding ReceiptDateText, UpdateSourceTrigger=LostFocus}" />
                </Grid>

                <!-- 行2: 得意先 -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="得意先" VerticalAlignment="Center" />
                    <TextBox x:Name="CustomerCodeBox"
                             Grid.Column="1"
                             IsReadOnly="{Binding IsExistingLoaded}"
                             Text="{Binding CustomerCode, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="コード（Space検索）">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Space"  Command="{Binding OpenCustomerSearchCommand}" />
                            <KeyBinding Key="Return" Command="{Binding LookupCustomerByCodeCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBox Grid.Column="3"
                             Text="{Binding CustomerName, Mode=OneWay}"
                             IsReadOnly="True"
                             IsTabStop="False"
                             Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                </Grid>

                <!-- 行3: 請求残高（参考表示。読み取り専用） -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="請求残高" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding OutstandingTotal, StringFormat={}{0:N0}}"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               FontWeight="SemiBold"
                               ToolTip="得意先確定時点の、確定済み請求に対する未収額の合計" />
                </Grid>

                <!-- 行4: 摘要 -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="摘要" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             IsReadOnly="{Binding IsExistingLoaded}"
                             Text="{Binding SlipRemarks, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="（任意）"
                             MaxLength="200" />
                </Grid>

            </StackPanel>
        </Border>

        <!-- ===== 明細（支払手段の内訳） ===== -->
        <Grid Grid.Row="2" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 列ヘッダー（ReceiptLineControl の列幅と一致させる） -->
            <Border Grid.Row="0" BorderThickness="0,1,0,1" Padding="0,3"
                    Background="{DynamicResource MahApps.Brushes.Gray10}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"  />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*"   />
                        <ColumnDefinition Width="28"  />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="入金方法" Padding="2,0" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="入金先口座" Padding="2,0" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="手形期日" Padding="2,0" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="金額" Padding="2,0" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="行摘要" Padding="2,0" FontSize="11" FontWeight="SemiBold" />
                </Grid>
            </Border>

            <!-- 明細行リスト -->
            <ScrollViewer Grid.Row="1"
                          IsEnabled="{Binding IsEditable}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:ReceiptLineControl />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 行追加ボタン -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,2,4,4">
                <Button Command="{Binding AddLineCommand}" Content="行追加 (F2)" Padding="8,2" />
            </StackPanel>
        </Grid>

        <!-- ===== フッター ===== -->
        <Grid Grid.Row="3" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="《今回入金額》" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Text="{Binding ReceiptTotal, StringFormat={}{0:N0}}" HorizontalAlignment="Right" FontWeight="Bold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="《入金後残高》" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Text="{Binding OutstandingAfterReceiptTotal, StringFormat={}{0:N0}}"
                               HorizontalAlignment="Right" FontWeight="Bold" FontSize="16"
                               Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="2"
                    Content="保存 (F10)"
                    Command="{Binding SaveCommand}"
                    ToolTip="入金を保存します (F10)"
                    Padding="16,6"
                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" />
        </Grid>

        <!-- ===== StatusBar ===== -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="処理中..." Foreground="OrangeRed"
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</mah:MetroWindow>
