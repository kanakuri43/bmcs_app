<UserControl x:Class="bmcs_app.Views.Receipt.DetailReceiptLineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">

    <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray9}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"  />  <!-- 行番号 -->
                <ColumnDefinition Width="150" />  <!-- 充当先（読取） -->
                <ColumnDefinition Width="90"  />  <!-- 入金方法 -->
                <ColumnDefinition Width="130" />  <!-- 入金先口座（振込のみ） -->
                <ColumnDefinition Width="90"  />  <!-- 金額（読取） -->
                <ColumnDefinition Width="*"   />  <!-- 行摘要 -->
                <ColumnDefinition Width="28"  />  <!-- 削除 -->
            </Grid.ColumnDefinitions>

            <!-- 行番号 -->
            <TextBlock Grid.Column="0"
                       Text="{Binding LineNumber}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource MahApps.Brushes.Gray3}" />

            <!-- 充当先（読取専用） -->
            <TextBlock Grid.Column="1"
                       Text="{Binding TargetDisplay}"
                       VerticalAlignment="Center"
                       Margin="2,0"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding TargetDisplay}" />

            <!-- 入金方法 -->
            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding DataContext.ReceiptMethodOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                      SelectedValue="{Binding ReceiptMethod}"
                      SelectedValuePath="Value"
                      DisplayMemberPath="Display"
                      Margin="1,1,0,1" />

            <!-- 入金先口座（振込のときだけ表示） -->
            <ComboBox x:Name="BankAccountBox"
                      Grid.Column="3"
                      Visibility="{Binding IsBankAccountVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                      ItemsSource="{Binding DataContext.BankAccounts, RelativeSource={RelativeSource AncestorType=Window}}"
                      SelectedValue="{Binding BankAccountCode}"
                      SelectedValuePath="BankAccountCode"
                      DisplayMemberPath="BankName"
                      Margin="2,1,0,1" />

            <!-- 金額（読取専用。対象の全額または残額で固定） -->
            <TextBlock Grid.Column="4"
                       Text="{Binding Amount, StringFormat={}{0:N0}}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,4,0"
                       Foreground="{DynamicResource MahApps.Brushes.Gray3}" />

            <!-- 行摘要 -->
            <TextBox Grid.Column="5"
                     Text="{Binding LineRemarks, UpdateSourceTrigger=PropertyChanged}"
                     mah:TextBoxHelper.Watermark="行摘要"
                     Margin="2,1,0,1" />

            <!-- 行削除ボタン -->
            <Button Grid.Column="6"
                    Command="{Binding DeleteCommand}"
                    Content="×"
                    IsTabStop="False"
                    FontSize="10"
                    Padding="0"
                    Margin="2,1,1,1"
                    ToolTip="この行を削除"
                    Style="{DynamicResource MahApps.Styles.Button.Flat}" />
        </Grid>
    </Border>
</UserControl>
