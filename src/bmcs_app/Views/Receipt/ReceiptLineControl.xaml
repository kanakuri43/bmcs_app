<UserControl x:Class="bmcs_app.Views.Receipt.ReceiptLineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">

    <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray9}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"  />  <!-- 行番号 -->
                <ColumnDefinition Width="130" />  <!-- 入金方法 -->
                <ColumnDefinition Width="150" />  <!-- 入金先口座（振込のみ） -->
                <ColumnDefinition Width="120" />  <!-- 手形期日（手形のみ） -->
                <ColumnDefinition Width="120" />  <!-- 金額 -->
                <ColumnDefinition Width="*"   />  <!-- 行摘要 -->
                <ColumnDefinition Width="28"  />  <!-- 削除 -->
            </Grid.ColumnDefinitions>

            <!-- 行番号 -->
            <TextBlock Grid.Column="0"
                       Text="{Binding LineNumber}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource MahApps.Brushes.Gray3}" />

            <!-- 入金方法 -->
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding DataContext.ReceiptMethodOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                      SelectedValue="{Binding ReceiptMethod}"
                      SelectedValuePath="Value"
                      DisplayMemberPath="Display"
                      Margin="{StaticResource SlipLineCellMargin}" />

            <!-- 入金先口座（振込のときだけ表示） -->
            <ComboBox x:Name="BankAccountBox"
                      Grid.Column="2"
                      Visibility="{Binding IsBankAccountVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                      ItemsSource="{Binding DataContext.BankAccounts, RelativeSource={RelativeSource AncestorType=Window}}"
                      SelectedValue="{Binding BankAccountCode}"
                      SelectedValuePath="BankAccountCode"
                      DisplayMemberPath="BankName"
                      Margin="{StaticResource SlipLineCellMargin}" />

            <!-- 手形期日（手形のときだけ表示） -->
            <DatePicker Grid.Column="3"
                        Visibility="{Binding IsBillDueDateVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        mah:TextBoxHelper.Watermark="yyyy/MM/dd"
                        SelectedDate="{Binding BillDueDate}"
                        Margin="{StaticResource SlipLineCellMargin}" />

            <!-- 金額 -->
            <TextBox x:Name="AmountBox"
                     Grid.Column="4"
                     Style="{StaticResource AmountTextBoxStyle}"
                     Text="{Binding Amount}"
                     Margin="{StaticResource SlipLineCellMargin}" />

            <!-- 行摘要 -->
            <TextBox Grid.Column="5"
                     Text="{Binding LineRemarks, UpdateSourceTrigger=PropertyChanged}"
                     mah:TextBoxHelper.Watermark="行摘要"
                     Margin="{StaticResource SlipLineCellMargin}" />

            <!-- 行削除ボタン -->
            <Button Grid.Column="6"
                    Command="{Binding DeleteCommand}"
                    Content="×"
                    IsTabStop="False"
                    FontSize="10"
                    Padding="0"
                    Margin="{StaticResource SlipLineLastCellMargin}"
                    ToolTip="この行を削除"
                    Style="{DynamicResource MahApps.Styles.Button.Flat}" />
        </Grid>
    </Border>
</UserControl>
