<mah:MetroWindow x:Class="bmcs_app.Views.CompanyInfoSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    Title="自社情報設定"
    Height="600" Width="580"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowTransitionsEnabled="False">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <!-- 口座情報 セクション -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition  />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 会社名 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="会社名" VerticalAlignment="Center" />
        <TextBox   Grid.Row="0" Grid.Column="1"
                   Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                   mah:TextBoxHelper.Watermark="会社名" />

        <!-- 住所 -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="住所" VerticalAlignment="Center" />
        <TextBox   Grid.Row="2" Grid.Column="1"
                   Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                   mah:TextBoxHelper.Watermark="住所" />

        <!-- 電話 -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="電話" VerticalAlignment="Center" />
        <TextBox   Grid.Row="4" Grid.Column="1"
                   Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                   mah:TextBoxHelper.Watermark="電話番号" />

        <!-- FAX -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="FAX" VerticalAlignment="Center" />
        <TextBox   Grid.Row="6" Grid.Column="1"
                   Text="{Binding Fax, UpdateSourceTrigger=PropertyChanged}"
                   mah:TextBoxHelper.Watermark="FAX番号" />

        <!-- インボイス登録番号 -->
        <TextBlock Grid.Row="8" Grid.Column="0" Text="インボイス登録番号" VerticalAlignment="Center" />
        <TextBox   Grid.Row="8" Grid.Column="1"
                   Text="{Binding InvoiceRegistrationNo, UpdateSourceTrigger=PropertyChanged}"
                   mah:TextBoxHelper.Watermark="T + 13桁" />

        <!-- 区切り -->
        <TextBlock Grid.Row="10" Grid.ColumnSpan="2"
                   Text="振込先口座"
                   FontWeight="Bold"
                   FontSize="12"
                   Foreground="{DynamicResource MahApps.Brushes.Gray3}" />

        <!-- 口座1 -->
        <TextBlock Grid.Row="12" Grid.Column="0" Text="口座 1" VerticalAlignment="Center" />
        <TextBox   Grid.Row="12" Grid.Column="1"
                   Text="{Binding BankAccountNumber1, UpdateSourceTrigger=PropertyChanged}"
                   mah:TextBoxHelper.Watermark="銀行名・支店・口座種別・口座番号など" />

        <!-- 口座2 -->
        <TextBlock Grid.Row="14" Grid.Column="0" Text="口座 2" VerticalAlignment="Center" />
        <TextBox   Grid.Row="14" Grid.Column="1"
                   Text="{Binding BankAccountNumber2, UpdateSourceTrigger=PropertyChanged}"
                   mah:TextBoxHelper.Watermark="（任意）" />

        <!-- 口座3 -->
        <TextBlock Grid.Row="16" Grid.Column="0" Text="口座 3" VerticalAlignment="Center" />
        <TextBox   Grid.Row="16" Grid.Column="1"
                   Text="{Binding BankAccountNumber3, UpdateSourceTrigger=PropertyChanged}"
                   mah:TextBoxHelper.Watermark="（任意）" />

        <!-- 保存ボタン -->
        <Button Grid.Row="18" Grid.Column="1"
                Content="保存 (F10)"
                Command="{Binding SaveCommand}"
                Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                HorizontalAlignment="Right"
                Width="96"
                Margin="0,12,0,0" />

        <!-- ステータス -->
        <TextBlock Grid.Row="19" Grid.ColumnSpan="2"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource MahApps.Brushes.Accent}"
                   FontSize="11" />
    </Grid>

    <Window.InputBindings>
        <KeyBinding Key="F10" Command="{Binding SaveCommand}" />
    </Window.InputBindings>
</mah:MetroWindow>
