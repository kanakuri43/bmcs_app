<mah:MetroWindow x:Class="bmcs_app.Views.Common.ClosingCustomerSelectDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="bmcs_app - 締め対象得意先の選択"
                 Height="520" Width="620"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 WindowTransitionsEnabled="False">
    <mah:MetroWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </mah:MetroWindow.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="得意先検索..." Command="{Binding SearchCommand}" Padding="12,4" Margin="0,0,8,0" />
        </StackPanel>

        <!-- 選ばれた得意先だけを表示する -->
        <ListView Grid.Row="1" ItemsSource="{Binding Results}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="コード" Width="80" DisplayMemberBinding="{Binding CustomerCode}" />
                    <GridViewColumn Header="名称" Width="240" DisplayMemberBinding="{Binding CustomerName}" />
                    <GridViewColumn Header="カナ" Width="200" DisplayMemberBinding="{Binding CustomerNameKana}" />
                    <GridViewColumn Header="" Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="×" Padding="6,0" ToolTip="一覧から外す"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="OrangeRed" TextWrapping="Wrap" Margin="0,8,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="選択確定" Command="{Binding ConfirmCommand}" Padding="16,6" Margin="0,0,12,0" />
            <Button Content="キャンセル（Esc）" Command="{Binding CancelCommand}" Padding="16,6" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
