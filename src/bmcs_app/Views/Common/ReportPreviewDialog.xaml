<mah:MetroWindow x:Class="bmcs_app.Views.Common.ReportPreviewDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="bmcs_app - 帳票プレビュー"
                 Height="900" Width="760"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 WindowTransitionsEnabled="False">
    <!--
        全帳票が共通で使う帳票プレビュー（特定帳票の知識を持たない）。
        DocumentViewer は既定で組込みツールバー（印刷ボタン＝標準の印刷ダイアログを開く）を持つが、
        「設定済みプリンタへダイアログなしで直接送信する」方針（docs/report-spec.md 1章）と
        矛盾するため、ControlTemplate を PART_ContentHost（DocumentViewer が要求する名前付き
        ScrollViewer）だけに絞ってツールバーを取り除き、印刷・PDF保存は下部の自前ボタンに一本化する。
    -->
    <mah:MetroWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}" />
    </mah:MetroWindow.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1">
            <DocumentViewer Document="{Binding Document}" Zoom="90">
                <DocumentViewer.Template>
                    <ControlTemplate TargetType="DocumentViewer">
                        <ScrollViewer x:Name="PART_ContentHost" CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="{DynamicResource MahApps.Brushes.Gray9}" />
                    </ControlTemplate>
                </DocumentViewer.Template>
            </DocumentViewer>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Margin="0,8,0,0" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="印刷（Ctrl+P）" Command="{Binding PrintCommand}"
                    Padding="16,6" Margin="0,0,12,0"
                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" />
            <Button Content="PDF保存" Command="{Binding SavePdfCommand}" Padding="16,6" Margin="0,0,12,0" />
            <Button Content="閉じる（Esc）" Command="{Binding CancelCommand}" Padding="16,6" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
