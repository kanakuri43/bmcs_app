<UserControl x:Class="bmcs_app.Views.Common.SlipLineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    Focusable="False">

    <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray9}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"  />  <!-- 行番号 -->
                <ColumnDefinition Width="110" />  <!-- 商品コード -->
                <ColumnDefinition Width="*"   />  <!-- 商品名 -->
                <ColumnDefinition Width="68"  />  <!-- 区分 -->
                <ColumnDefinition Width="72"  />  <!-- 数量 -->
                <ColumnDefinition Width="88"  />  <!-- 単価 -->
                <ColumnDefinition Width="80"  />  <!-- 原価 -->
                <ColumnDefinition Width="96"  />  <!-- 金額 -->
                <ColumnDefinition Width="56"  />  <!-- 税率 -->
                <ColumnDefinition Width="130" />  <!-- 行摘要 -->
                <ColumnDefinition Width="28"  />  <!-- 削除 -->
            </Grid.ColumnDefinitions>

            <!-- 行番号 -->
            <TextBlock Grid.Column="0"
                       Text="{Binding LineNumber}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource MahApps.Brushes.Gray3}" />

            <!-- 商品コード -->
            <TextBox x:Name="ProductCodeBox"
                     Grid.Column="1"
                     Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"
                     mah:TextBoxHelper.Watermark="コード（SPACEで検索）"
                     Margin="{StaticResource SlipLineCellMargin}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Space"  Command="{Binding OpenProductLookupCommand}" />
                    <KeyBinding Key="Return" Command="{Binding LookupProductByCodeCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <!-- 商品名（通常は表示のみ） -->
            <TextBox Grid.Column="2"
                     Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsProductNameReadOnly}"
                     IsTabStop="False"
                     Margin="{StaticResource SlipLineCellMargin}">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProductNameReadOnly}" Value="True">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background"      Value="Transparent" />
                                <Setter Property="Foreground"      Value="{DynamicResource MahApps.Brushes.Gray3}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!-- 区分（売上／返品／値引。TODO.md 5-4。受注入力では非表示） -->
            <ComboBox Grid.Column="3"
                      Visibility="{Binding IsSlipTypeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                      ItemsSource="{Binding SlipTypeOptions}"
                      SelectedItem="{Binding SlipType}"
                      IsTabStop="False"
                      Margin="{StaticResource SlipLineCellMargin}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- 数量 -->
            <TextBox x:Name="QuantityBox"
                     Grid.Column="4"
                     Style="{StaticResource QuantityTextBoxStyle}"
                     Text="{Binding Quantity}"
                     Margin="{StaticResource SlipLineCellMargin}" />

            <!-- 単価（商品マスタから初期値が転記される。手入力で上書き可＝TODO.md 4-2） -->
            <TextBox Grid.Column="5"
                     Style="{StaticResource AmountTextBoxStyle}"
                     Text="{Binding UnitPrice}"
                     Margin="{StaticResource SlipLineCellMargin}" />

            <!-- 原価（表示のみ） -->
            <TextBlock Grid.Column="6"
                       Text="{Binding CostPrice, StringFormat={}{0:N0}}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                       Padding="4,0" />

            <!-- 金額（表示のみ） -->
            <TextBlock Grid.Column="7"
                       Text="{Binding Amount, StringFormat={}{0:N0}}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       FontWeight="SemiBold"
                       Padding="4,0" />

            <!-- 税率（表示のみ） -->
            <TextBlock Grid.Column="8"
                       Text="{Binding TaxRateDisplay}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Padding="4,0" />

            <!-- 行摘要 -->
            <TextBox Grid.Column="9"
                     Text="{Binding LineRemarks, UpdateSourceTrigger=PropertyChanged}"
                     mah:TextBoxHelper.Watermark="行摘要"
                     Margin="{StaticResource SlipLineCellMargin}" />

            <!-- 行削除ボタン -->
            <Button Grid.Column="10"
                    Command="{Binding DeleteCommand}"
                    Content="×"
                    IsTabStop="False"
                    FontSize="10"
                    Padding="0"
                    Margin="{StaticResource SlipLineLastCellMargin}"
                    ToolTip="この行を削除"
                    Style="{DynamicResource MahApps.Styles.Button.Flat}" />
        </Grid>
    </Border>
</UserControl>
