<mah:MetroWindow x:Class="bmcs_app.Views.Common.DepositMethodMasterSearchDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                 Title="bmcs_app - 入金方法検索"
                 Height="480" Width="600"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 WindowTransitionsEnabled="False">
    <mah:MetroWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </mah:MetroWindow.InputBindings>

    <Grid Margin="16" beh:EnterKeyNavigationBehavior.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="検索（コード・名称）" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox x:Name="SearchKeywordTextBox" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                     Width="360" />
        </StackPanel>

        <ListView Grid.Row="1" x:Name="ResultsListView" ItemsSource="{Binding Results}"
                   SelectedIndex="{Binding SelectedIndex}"
                   beh:RowActivationBehavior.Command="{Binding ConfirmCommand}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="コード" Width="80" DisplayMemberBinding="{Binding DepositMethodCode}" />
                    <GridViewColumn Header="名称" Width="120" DisplayMemberBinding="{Binding DepositMethodName}" />
                    <GridViewColumn Header="口座必須" Width="70" DisplayMemberBinding="{Binding RequiresBankAccountDisplay}" />
                    <GridViewColumn Header="期日必須" Width="70" DisplayMemberBinding="{Binding RequiresBillDueDateDisplay}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="選択（Enter）" Command="{Binding ConfirmCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=ResultsListView}"
                    Padding="16,6" Margin="0,0,12,0" />
            <Button Content="キャンセル（Esc）" Command="{Binding CancelCommand}" Padding="16,6" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
