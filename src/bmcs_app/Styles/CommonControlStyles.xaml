<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:beh="clr-namespace:bmcs_app.Behaviors"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">

    <ResourceDictionary.MergedDictionaries>
        <!--
            BasedOn="{StaticResource MahApps.Styles.XxxYyy}" の解決には、MahApps の
            既定スタイルがこの辞書自身のマージスコープ内に存在する必要がある。
            App.xaml で既に Controls.xaml をマージしていても、StaticResource は
            参照元ファイル自身のスコープでしか解決されないため、ここでも再マージする。
            Metrics.xaml も同じ理由でここに再マージする（App.xaml へ足すだけでは
            このファイル内の StaticResource InputControlHeight 等は解決できない）。

            重要: MahApps.Metro は TextBox/ComboBox/Button 等に対して暗黙スタイル
            （x:Key 無し・TargetType のみ）を提供しない。キー付きスタイル
            （x:Key="MahApps.Styles.TextBox" 等）のみが定義されている
            （SPACE検索欄のWatermarkが表示されない原因だった）。
            このため BasedOn には必ず明示的なキー名（"MahApps.Styles.TextBox" 等）を
            指定すること。`{StaticResource {x:Type TextBox}}` は MahApps の既定スタイルには
            解決されず、このファイル自身が下で定義する暗黙 `<Style TargetType="TextBox">`
            （高さ調整のみを持つ、ControlTemplateを持たないもの）を指してしまい、
            Watermark 等 MahApps 固有のテンプレート機能が丸ごと欠落する
            （高さ調整自体は MinHeight 等の汎用プロパティなので効いて見え、気付きにくい）。
        -->
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
        <ResourceDictionary Source="Colors.xaml" />
        <ResourceDictionary Source="Metrics.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        全画面共通の入力欄高さ。TextBox/ComboBox/DatePicker の
        自然高がばらつき、同じ行に並べたときに高さが揃わない問題への対応（詳細は
        docs/architecture.md 12章）。
        - MinHeight だけでは行の Stretch により他コントロールに引き伸ばされてしまうため、
          VerticalAlignment="Center" を併せて設定し、常に自身の自然高（か MinHeight の
          大きい方）だけを取るようにする。
        - VerticalContentAlignment="Center" は、MinHeight が自然高より大きいときに
          文字が上端に寄るのを防ぐ。
        キー付きスタイルとして基底に置き、Amount/Quantity 等の派生スタイルが高さを
        確実に継承していることを BasedOn の連鎖で目視確認できるようにする。
    -->
    <Style x:Key="InputTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
        <Setter Property="MinHeight" Value="{StaticResource InputControlHeight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource FocusedInputBackgroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 全画面共通: XAML で Style を明示しない TextBox にも上記の高さ・背景色を適用する。 -->
    <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}" />

    <Style x:Key="AmountTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="beh:FormattedTextBoxBehavior.Kind" Value="Amount" />
    </Style>

    <Style x:Key="QuantityTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="beh:FormattedTextBoxBehavior.Kind" Value="Quantity" />
    </Style>

    <!-- ComboBox にも TextBox と同じ高さ3点セットを適用し、同一行に並べたときに高さを揃える。 -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource MahApps.Styles.ComboBox}">
        <Setter Property="MinHeight" Value="{StaticResource InputControlHeight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
        DatePicker。MahApps.Styles.DatePicker は暗黙スタイルとして定義されていない
        （x:Key 指定必須）ため、この暗黙スタイルが「MahApps の見た目にする」役も兼ねる。
        DatePickerInputBehavior は日付専用コントロールである DatePicker に対する暗黙適用のため、
        13章の「暗黙スタイルでキー操作を全画面自動適用しない」方針の対象外とする
        （XAML側に書き忘れる余地をなくすため、全 DatePicker に一律適用する）。
    -->
    <Style TargetType="DatePicker" BasedOn="{StaticResource MahApps.Styles.DatePicker}">
        <Setter Property="MinHeight" Value="{StaticResource InputControlHeight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="beh:DatePickerInputBehavior.IsEnabled" Value="True" />
    </Style>

    <!--
        Button。ComboBox/DatePicker/Button が横一列に並ぶ画面（請求締め・締め解除等）で
        天地を揃えるため MinHeight のみ適用する。VerticalAlignment=Center は付けない
        （明細行の削除ボタンが Stretch で行高に追随している現状を壊さないため）。
        Style="{DynamicResource MahApps.Styles.Button.Flat}" 等を明示指定している要素には
        暗黙スタイルは継承されない（明示 Style が暗黙 Style を置換するため）。
    -->
    <Style TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
        <Setter Property="MinHeight" Value="{StaticResource InputControlHeight}" />
    </Style>

    <!--
        伝票ナビゲーション（前へ/次へ）ボタン。ジャーナル系画面（受注入力・売上入力）の
        ヘッダーツールバーに置く「|◀」「▶|」の置き換え。文字のシェブロン
        （‹›）は小さく視認性が低いため、太いストローク付きの
        ベクターアイコン（Path）を使う。フォントに依存しないため機種差の心配もない。
        通常時は薄いグレーの正方形、ホバー時のみアクセント色にする（26px）。
    -->
    <Style x:Key="SlipNavButtonBaseStyle" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray1}" />
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray10}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="SlipPrevButtonStyle" TargetType="Button" BasedOn="{StaticResource SlipNavButtonBaseStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                        <Viewbox Width="10" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 10,2 L 2,11 L 10,20"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlipNextButtonStyle" TargetType="Button" BasedOn="{StaticResource SlipNavButtonBaseStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                        <Viewbox Width="10" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 2,2 L 10,11 L 2,20"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
