<UserControl x:Class="bmcs_app.Receipt.Views.ReceiptLineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:h="clr-namespace:bmcs_app.Shared.Helpers;assembly=bmcs_app.Shared">

    <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray9}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"  />  <!-- 行番号 -->
                <ColumnDefinition Width="130" />  <!-- 入金区分 -->
                <ColumnDefinition Width="120" />  <!-- 手形期日 -->
                <ColumnDefinition Width="120" />  <!-- 金額 -->
                <ColumnDefinition Width="*"   />  <!-- 行摘要 -->
                <ColumnDefinition Width="28"  />  <!-- 削除 -->
            </Grid.ColumnDefinitions>

            <!-- 行番号 -->
            <TextBlock Grid.Column="0"
                       Text="{Binding LineNo}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource MahApps.Brushes.Gray3}" />

            <!-- 入金区分 ComboBox（RelativeSource で Window.DataContext.PaymentMethods を参照） -->
            <ComboBox x:Name="PaymentMethodBox"
                      Grid.Column="1"
                      ItemsSource="{Binding DataContext.PaymentMethods,
                                   RelativeSource={RelativeSource AncestorType=Window}}"
                      SelectedItem="{Binding PaymentMethod}"
                      DisplayMemberPath="PaymentMethodName"
                      h:FocusHelper.MoveNextOnEnter="True"
                      Margin="2,1,0,1" />

            <!-- 手形期日（手形選択時のみ表示） -->
            <DatePicker Grid.Column="2"
                        SelectedDate="{Binding BillDueDate}"
                        SelectedDateFormat="Short"
                        Visibility="{Binding IsBillDueDateVisible,
                                     Converter={StaticResource BooleanToVisibilityConverter}}"
                        h:FocusHelper.MoveNextOnEnter="True"
                        Margin="2,1,0,1" />

            <!-- 金額 -->
            <TextBox Grid.Column="3"
                     x:Name="AmountBox"
                     Text="{Binding Amount, StringFormat={}{0:N0}}"
                     TextAlignment="Right"
                     FontWeight="SemiBold"
                     h:FocusHelper.MoveNextOnEnter="True"
                     GotKeyboardFocus="OnTextBoxGotKeyboardFocus"
                     Margin="2,1,0,1" />

            <!-- 行摘要 -->
            <TextBox Grid.Column="4"
                     Text="{Binding LineRemarks, UpdateSourceTrigger=PropertyChanged}"
                     mah:TextBoxHelper.Watermark="（任意）"
                     GotKeyboardFocus="OnTextBoxGotKeyboardFocus"
                     Margin="2,1,0,1">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding LineRemarksEnterCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <!-- 行削除ボタン -->
            <Button Grid.Column="5"
                    Command="{Binding DeleteCommand}"
                    Content="×"
                    IsTabStop="False"
                    FontSize="10"
                    Padding="0"
                    Margin="2,1,1,1"
                    ToolTip="この行を削除"
                    Style="{DynamicResource MahApps.Styles.Button.Flat}" />
        </Grid>
    </Border>
</UserControl>
