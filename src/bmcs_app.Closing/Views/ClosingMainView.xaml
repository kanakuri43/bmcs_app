<mah:MetroWindow x:Class="bmcs_app.Closing.Views.ClosingMainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    Title="締め処理"
    Height="720" Width="1100"
    WindowStartupLocation="CenterScreen"
    WindowTransitionsEnabled="False">

    <Window.InputBindings>
        <KeyBinding Key="F8"  Command="{Binding CancelAggregationCommand}" />
        <KeyBinding Key="F10" Command="{Binding AggregateCommand}" />
        <KeyBinding Key="F11" Command="{Binding PrintCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== タブ ===== -->
        <TabControl Grid.Row="0"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Margin="8,8,8,4">

            <!-- ========== Tab 1: 請求処理 ========== -->
            <TabItem Header="請求処理">
                <Border Padding="24,20"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                        BorderThickness="1"
                        Margin="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 締め日 -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="対象締日"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,12" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding InvoiceTab.ClosingDays}"
                                  SelectedItem="{Binding InvoiceTab.SelectedClosingDay}"
                                  DisplayMemberPath="Label"
                                  Width="100"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,12" />

                        <!-- 処理日付 -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="処理日付"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,12" />
                        <StackPanel Grid.Row="1" Grid.Column="1"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <DatePicker SelectedDate="{Binding InvoiceTab.ProcessDate}"
                                        Width="130" />
                        </StackPanel>

                        <!-- 得意先 -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="得意先"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Row="2" Grid.Column="1"
                                    Orientation="Horizontal">
                            <RadioButton Content="全件"
                                         IsChecked="{Binding InvoiceTab.IsAllCustomers}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0" />
                            <RadioButton Content="指定"
                                         IsEnabled="False"
                                         IsChecked="{Binding InvoiceTab.IsSpecificCustomer}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0" />
                            <TextBox Text="{Binding InvoiceTab.CustomerCode, UpdateSourceTrigger=PropertyChanged}"
                                     Width="70"
                                     IsEnabled="{Binding InvoiceTab.IsSpecificCustomer}"
                                     mah:TextBoxHelper.Watermark="コード"
                                     Margin="0,0,4,0" />
                            <TextBox Text="{Binding InvoiceTab.CustomerName, Mode=OneWay}"
                                     Width="140"
                                     IsReadOnly="True"
                                     IsEnabled="{Binding InvoiceTab.IsSpecificCustomer}"
                                     Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                        </StackPanel>

                        <!-- 集計実行ボタン -->
                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Command="{Binding InvoiceTab.AggregateCommand}"
                                    Content="集計実行 (F10)"
                                    Width="130"
                                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" />
                        </StackPanel>

                        <!-- 集計履歴リスト -->
                        <DataGrid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                  ItemsSource="{Binding InvoiceTab.HistoryItems}"
                                  SelectedItem="{Binding InvoiceTab.SelectedHistoryItem, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="対象締日"   Binding="{Binding ClosingDayLabel}"  Width="90" />
                                <DataGridTextColumn Header="処理日付"   Binding="{Binding InvoiceDateLabel}" Width="110" />
                                <DataGridTextColumn Header="得意先件数" Binding="{Binding CustomerCount}"    Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Margin" Value="0,0,8,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 印刷・締め解除ボタン -->
                        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Command="{Binding InvoiceTab.PrintCommand}"
                                    Content="請求書印刷 (F11)"
                                    Width="140" />
                            <Button Command="{Binding InvoiceTab.CancelAggregationCommand}"
                                    Content="締め解除 (F8)"
                                    Width="140"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ========== Tab 2: 売掛金集計 ========== -->
            <TabItem Header="売掛金集計">
                <Border Padding="24,20"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                        BorderThickness="1"
                        Margin="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 処理日付 -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="処理日付"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,12" />
                        <StackPanel Grid.Row="0" Grid.Column="1"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <DatePicker SelectedDate="{Binding ArTab.ProcessDate}"
                                        Width="130" />
                        </StackPanel>

                        <!-- 得意先 -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="得意先"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1"
                                    Orientation="Horizontal">
                            <RadioButton Content="全件"
                                         IsChecked="{Binding ArTab.IsAllCustomers}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0" />
                            <RadioButton Content="指定"
                                         IsEnabled="False"
                                         IsChecked="{Binding ArTab.IsSpecificCustomer}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0" />
                            <TextBox Text="{Binding ArTab.CustomerCode, UpdateSourceTrigger=PropertyChanged}"
                                     Width="70"
                                     IsEnabled="{Binding ArTab.IsSpecificCustomer}"
                                     mah:TextBoxHelper.Watermark="コード"
                                     Margin="0,0,4,0" />
                            <TextBox Text="{Binding ArTab.CustomerName, Mode=OneWay}"
                                     Width="140"
                                     IsReadOnly="True"
                                     IsEnabled="{Binding ArTab.IsSpecificCustomer}"
                                     Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                        </StackPanel>

                        <!-- ボタン群 -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Command="{Binding ArTab.AggregateCommand}"
                                    Content="集計実行 (F10)"
                                    Width="130"
                                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" />
                            <Button Command="{Binding ArTab.CancelAggregationCommand}"
                                    Content="締め解除 (F8)"
                                    Width="140"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>

        <!-- ===== StatusBar ===== -->
        <StatusBar Grid.Row="1">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</mah:MetroWindow>
