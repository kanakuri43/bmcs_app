<mah:MetroWindow x:Class="bmcs_app.Shared.Views.SlipSearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    Title="伝票検索"
    Height="720" Width="1100"
    MinHeight="360" MinWidth="600"
    WindowStartupLocation="CenterOwner"
    WindowTransitionsEnabled="False"
    ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- キーワード検索 -->
        <TextBox x:Name="KeywordBox"
                 Grid.Row="0"
                 mah:TextBoxHelper.Watermark="キーワードで絞り込み"
                 mah:TextBoxHelper.ClearTextButton="True"
                 TextChanged="KeywordBox_TextChanged"
                 KeyDown="KeywordBox_KeyDown" />

        <!-- 一覧 -->
        <DataGrid x:Name="SlipGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  KeyDown="SlipGrid_KeyDown"
                  MouseDoubleClick="SlipGrid_MouseDoubleClick" />

        <!-- ボタン -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="確定 (Enter)"
                    Click="ConfirmButton_Click"
                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                    Padding="12,4"
                    Margin="0,0,8,0"
                    IsDefault="True" />
            <Button Content="キャンセル (Esc)"
                    Click="CancelButton_Click"
                    Padding="12,4"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
